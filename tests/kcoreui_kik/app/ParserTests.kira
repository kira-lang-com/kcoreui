import Foundation
import KCoreUI

// What the parser refuses, and why.
//
// Every case starts from a blob the writer produced and damages it in exactly
// one way, so a rejection is attributable to the damage rather than to the
// construction. Strictness here is what buys byte-exact write-back everywhere
// else: the accepted set is the canonical set, so a catalog that loaded can
// only have been laid out one way.

function goodBytes() -> [U8] {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", color(0.1, 0.1, 0.1, 1.0), color(0.9, 0.9, 0.9, 1.0)))
    record.resources.append(flat("separator", color(0.0, 0.0, 0.0, 0.1)))
    return record.encoded()
}

function withByte(bytes: borrow [U8], offset: Number, value: Number) -> [U8] {
    var copied: [U8] = []
    for index in 0..bytes.count {
        if index == offset {
            copied.append(value & 255)
        } else {
            copied.append(bytes[index])
        }
    }
    return copied
}

function withU32(bytes: borrow [U8], offset: Number, value: Number) -> [U8] {
    var copied = withByte(bytes, offset, value)
    copied = withByte(copied, offset + 1, value >> 8)
    copied = withByte(copied, offset + 2, value >> 16)
    copied = withByte(copied, offset + 3, value >> 24)
    return copied
}

function truncated(bytes: borrow [U8], count: Number) -> [U8] {
    return sliceBytes(bytes, 0, count)
}

construct KcuAGoodBlobParses() extends Test {
    test { return parses(goodBytes()) }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuWrongMagicIsRefused() extends Test {
    test { return parseFailure(withByte(goodBytes(), 0, 88)) }
    expect {
        let e: Result<Any, TestFailure> = .Ok("not a KCoreUI catalog: wrong magic")
        return e
    }
}

construct KcuANewerMajorVersionIsRefused() extends Test {
    test {
        return parseFailure(
            withByte(goodBytes(), BlobHeaderOffset.major, BlobLayout.majorVersion + 1)
        )
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("catalog major version is newer than this build")
        return e
    }
}

construct KcuAShortHeaderIsRefused() extends Test {
    test { return parseFailure(truncated(goodBytes(), 12)) }
    expect {
        let e: Result<Any, TestFailure> = .Ok("catalog is shorter than its header")
        return e
    }
}

// Truncating the body leaves the header claiming a size the buffer does not
// have, which is a layout the writer could not have produced.
construct KcuATruncatedBodyIsRefused() extends Test {
    test { return parses(truncated(goodBytes(), BlobLayout.headerSize + 8)) }
    expect {
        let e: Result<Any, TestFailure> = .Ok(false)
        return e
    }
}

// Slack between sections would write back as a different file, so a header
// pointing anywhere but the canonical position is refused even though every
// offset it names is inside the buffer.
construct KcuANonCanonicalLayoutIsRefused() extends Test {
    test {
        let bytes = goodBytes()
        let moved = withU32(bytes, BlobHeaderOffset.resourceStart, BlobLayout.headerSize + 4)
        return parseFailure(moved)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("a catalog entry points outside the blob")
        return e
    }
}

construct KcuATotalSizeThatDisagreesWithTheBufferIsRefused() extends Test {
    test {
        let bytes = goodBytes()
        return parses(withU32(bytes, BlobHeaderOffset.totalSize, bytes.count + 16))
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(false)
        return e
    }
}

// The name table is what a lookup binary-searches, so a table out of order is a
// catalog whose lookups would silently miss.
construct KcuAnUnsortedNameTableIsRefused() extends Test {
    test {
        let bytes = goodBytes()
        // Two resources, `label` then `separator`. Pointing the first entry's
        // name span at the second name puts the table out of order.
        let firstEntry = BlobLayout.headerSize
        let swapped = withU32(withU32(bytes, firstEntry, 5), firstEntry + 4, 9)
        return parseFailure(swapped)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("the name table is not in byte order")
        return e
    }
}

// Constraints are stored ascending by identifier because the specificity
// comparison is a merge walk over that order.
construct KcuUnsortedConstraintsAreRefused() extends Test {
    test {
        var record = CatalogRecord()
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var rendition = RenditionRecord()
        rendition.constraints.append(Appearance.Light.constraint())
        rendition.constraints.append(Contrast.High.constraint())
        rendition.payload = authored(color(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(rendition)
        record.resources.append(resource)

        let bytes = record.encoded()
        // One resource, one rendition, two constraints. Reverse them in place.
        let constraintStart = BlobLayout.headerSize + BlobLayout.resourceEntrySize + BlobLayout.renditionEntrySize
        var reversed = withU32(bytes, constraintStart, TraitIdentifier.Contrast.value())
        reversed = withU32(reversed, constraintStart + 4, Contrast.High.value())
        reversed = withU32(reversed, constraintStart + 8, TraitIdentifier.Appearance.value())
        reversed = withU32(reversed, constraintStart + 12, Appearance.Light.value())
        return parseFailure(reversed)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(
            "a rendition's constraints are not in identifier order"
        )
        return e
    }
}

// Zero is reserved on every trait: a constraint carrying it would be
// indistinguishable from no constraint at all.
construct KcuAReservedTraitValueIsRefused() extends Test {
    test {
        var record = CatalogRecord()
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var rendition = RenditionRecord()
        rendition.constraints.append(TraitIdentifier.Appearance.constrain(0))
        rendition.payload = authored(color(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(rendition)
        record.resources.append(resource)
        return parseFailure(record.encoded())
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("a constraint carries the reserved value zero")
        return e
    }
}

// Two renditions pinning the same traits have no defined winner. Refusing at
// load is what lets the resolver promise one answer rather than an arbitrary
// one.
construct KcuADuplicateRenditionIsRefused() extends Test {
    test {
        var record = CatalogRecord()
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var first = RenditionRecord()
        first.constraints.append(Appearance.Light.constraint())
        first.payload = authored(color(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(first)
        var second = RenditionRecord()
        second.constraints.append(Appearance.Light.constraint())
        second.payload = authored(color(1.0, 1.0, 1.0, 1.0))
        resource.renditions.append(second)
        record.resources.append(resource)
        return parseFailure(record.encoded())
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok("two renditions of one resource pin the same traits")
        return e
    }
}

construct KcuAnEmptyBufferIsRefusedRatherThanTrapping() extends Test {
    test {
        var empty: [U8] = []
        return parses(empty)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(false)
        return e
    }
}
