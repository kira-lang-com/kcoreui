import Foundation

// What a producer's records are checked for before they become a blob.
//
// The parser refuses a malformed *container*. This refuses a malformed
// *catalog*: a reference to a name nothing defines, a reference chain that
// comes back to where it started, two resources with the same name. Those are
// authoring mistakes, and the place to catch them is the moment a producer asks
// for bytes, not the moment a compositor asks for a color.
//
// Cycle detection is deliberately conservative. References resolve per
// environment, so a chain that closes only under one combination of traits is
// still reported: an author who needs an appearance-dependent alias graph is
// describing something a resolver cannot promise to terminate, and the report
// is the right answer.

public enum ValidationKind {
    DuplicateName
    MissingReference
    ReferenceCycle
    ReservedTraitValue
    DuplicateRendition
    NoRenditions
    UndecodablePayload
}

public struct ValidationIssue {
    var kind: ValidationKind = .DuplicateName
    var name: String = ""
    var detail: String = ""
}

extend ValidationKind {
    function text() -> String {
        match self {
            DuplicateName -> return "duplicate name"
            MissingReference -> return "reference to an undefined name"
            ReferenceCycle -> return "reference cycle"
            ReservedTraitValue -> return "constraint carries the reserved value zero"
            DuplicateRendition -> return "two renditions pin the same traits"
            NoRenditions -> return "resource has no renditions"
            UndecodablePayload -> return "payload does not decode for its self"
        }
    }
}

public function issue(
    kind: borrow ValidationKind,
    name: borrow String,
    detail: borrow String
) -> ValidationIssue {
    var made = ValidationIssue()
    made.kind = kind
    made.name = name
    made.detail = detail
    return made
}

// --- Reference extraction --------------------------------------------------

function appendReference(names: borrow mut [String], source: borrow ColorSource) {
    if source.isReference {
        names.append(source.reference)
    }
}

// Every name a color's layer stack points at.
function appendLayerReferences(names: borrow mut [String], value: borrow ColorValue) {
    for layer in value.layers {
        appendReference(names, layer.source)
    }
}

extend ResourceKind {
    // Every name one payload points at. A kind this build cannot decode has no
    // references as far as KCoreUI is concerned, which is the honest answer: the
    // format does not read a payload it has no decoder for, so it cannot know.
    function payloadReferences(bytes: borrow [UN8]) -> [String] {
        var names: [String] = []
        match self {
            Color -> {
                let read = decodeColorPayload(bytes)
                if read.ok {
                    appendLayerReferences(names, read.value)
                }
                return names
            }
            Gradient -> {
                let read = decodeGradient(bytes)
                if read.ok {
                    for stop in read.value.stops {
                        appendReference(names, stop.color)
                    }
                }
                return names
            }
            Material -> {
                let read = decodeMaterial(bytes)
                if read.ok {
                    for layer in read.value.layers {
                        appendReference(names, layer.color)
                    }
                }
                return names
            }
            Effect -> {
                let read = decodeEffect(bytes)
                if read.ok {
                    for op in read.value.ops {
                        appendReference(names, op.color)
                    }
                }
                return names
            }
            Typography -> return names
            Metric -> return names
            Glass -> return names
            Custom(value) -> return names
            Unknown(value) -> return names
        }
    }

    // Whether a payload decodes at all for its kind. A kind this build has no
    // decoder for always does: the container is agnostic about payload.
    function payloadDecodes(bytes: borrow [UN8]) -> Bool {
        match self {
            Color -> return decodeColorPayload(bytes).ok
            Gradient -> return decodeGradient(bytes).ok
            Material -> return decodeMaterial(bytes).ok
            Effect -> return decodeEffect(bytes).ok
            Typography -> return decodeTypography(bytes).ok
            Metric -> return decodeMetric(bytes).ok
            Glass -> return decodeGlass(bytes).ok
            Custom(value) -> return true
            Unknown(value) -> return true
        }
    }
}

// --- Record checks ---------------------------------------------------------

extend CatalogRecord {
    function indexOf(name: borrow String, kind: borrow ResourceKind) -> Number {
        for index in 0..self.resources.count {
            if self.resources[index].kind.equals(kind) && compareStrings(
                self.resources[index].name,
                name
            ) == 0 {
                return index
            }
        }
        return -1
    }

    // Every name reachable from one resource, one hop.
    function resourceReferences(index: Number) -> [String] {
        var names: [String] = []
        if index < 0 || index >= self.resources.count {
            return names
        }
        let resource = self.resources[index]
        for rendition in resource.renditions {
            for name in resource.kind.payloadReferences(rendition.payload) {
                names.append(name)
            }
        }
        return names
    }

    // Whether following references out of `start` ever arrives back at it.
    //
    // A breadth-first walk with an explicit frontier rather than recursion, so the
    // bound is the resource count and a malformed graph cannot exhaust the stack.
    function referenceCycleFrom(start: Number) -> Bool {
        var seen: [Number] = []
        var frontier: [Number] = []
        for name in self.resourceReferences(start) {
            let next = self.indexOf(name, .Color)
            if next >= 0 {
                frontier.append(next)
            }
        }
        var cursor = 0
        while cursor < frontier.count {
            let current = frontier[cursor]
            cursor++
            if current == start {
                return true
            }
            var alreadySeen = false
            for entry in seen {
                if entry == current {
                    alreadySeen = true
                }
            }
            if !alreadySeen {
                seen.append(current)
                for name in self.resourceReferences(current) {
                    let next = self.indexOf(name, .Color)
                    if next >= 0 {
                        frontier.append(next)
                    }
                }
            }
        }
        return false
    }

    // Everything wrong with a set of records, in the order the resources were given.
    function validate() -> [ValidationIssue] {
        var issues: [ValidationIssue] = []
        for index in 0..self.resources.count {
            let resource = self.resources[index]

            if self.indexOf(resource.name, resource.kind) != index {
                issues.append(issue(.DuplicateName, resource.name, ""))
            }
            if resource.renditions.count == 0 {
                issues.append(issue(.NoRenditions, resource.name, ""))
            }

            for rendition in resource.renditions {
                for entry in rendition.constraints {
                    if entry.value == 0 {
                        issues.append(
                            issue(.ReservedTraitValue, resource.name, entry.identifier.name())
                        )
                    }
                }
                if !resource.kind.payloadDecodes(rendition.payload) {
                    issues.append(issue(.UndecodablePayload, resource.name, resource.kind.name()))
                }
                for name in resource.kind.payloadReferences(rendition.payload) {
                    if self.indexOf(name, .Color) < 0 {
                        issues.append(issue(.MissingReference, resource.name, name))
                    }
                }
            }

            let sorted = sortedRenditions(resource.renditions)
            for position in 1..sorted.count {
                if compareConstraintLists(
                    sorted[position - 1].constraints,
                    sorted[position].constraints
                ) == 0 {
                    issues.append(issue(.DuplicateRendition, resource.name, ""))
                }
            }

            if self.referenceCycleFrom(index) {
                issues.append(issue(.ReferenceCycle, resource.name, ""))
            }

        }
        return issues
    }
}

// The issues as text, one per line.
public function validationText(issues: borrow [ValidationIssue]) -> String {
    var text = ""
    for entry in issues {
        text = text + entry.kind.text() + ": " + entry.name
        if entry.detail.count > 0 {
            text = text + " (" + entry.detail + ")"
        }
        text = text + "\n"
    }
    return text
}

// --- Integrity -------------------------------------------------------------

extend Catalog {
    // The names a catalog does not define. This is the check that keeps a hardcoded
    // name surface and a shipped catalog from drifting apart: a name declared in
    // `Names` with no resource behind it is a lookup that would fall through the
    // floor, and the floor is what makes resolution total.
    function missingNames(names: borrow [String], kind: borrow ResourceKind) -> [String] {
        var missing: [String] = []
        for name in names {
            if !self.hasResource(name, kind) {
                missing.append(name)
            }
        }
        return missing
    }

    // The reverse: what the catalog carries under one kind that the name surface
    // does not declare. Not an error — a catalog may hold resources for a consumer
    // this build does not contain — but an editor and a review want to see it.
    function undeclaredNames(names: borrow [String], kind: borrow ResourceKind) -> [String] {
        var extra: [String] = []
        for index in 0..self.resources.count {
            if self.resources[index].kind.equals(kind) {
                let present = self.resourceName(index)
                var declared = false
                for name in names {
                    if compareStrings(present, name) == 0 {
                        declared = true
                    }
                }
                if !declared {
                    extra.append(present)
                }
            }
        }
        return extra
    }
}
