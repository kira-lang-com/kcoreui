import Foundation
import KCoreUI

// The resolution cache must be invisible: every answer it gives equals the
// answer the resolver gives without it, in every environment, and it is dropped
// whenever the catalog underneath it changes.

function cacheRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", color(0.0, 0.0, 0.0, 1.0), color(1.0, 1.0, 1.0, 1.0)))
    record.resources.append(
        adaptive("tint", color(0.25, 0.5, 1.0, 1.0), color(0.5, 0.75, 1.0, 1.0))
    )
    record.resources.append(alias("accentColor", "tint"))
    return record
}

@Test
function cachedColorsEqualTheUncachedResolution() {
    let stack = stackOf(cacheRecord())
    var cache = makeDefaultCache()
    let direct = stack.resolveColor("label", light())
    let cached = cache.color(stack, "label", light())
    let again = cache.color(stack, "label", light())
    expect!((colorsEqual(direct, cached)) == (true))
    expect!((colorsEqual(direct, again)) == (true))
    expect!((colorsEqual(cache.color(stack, "accentColor", dark()), stack.resolveColor("accentColor", dark()))) == (true))
}

// The environment is part of the key: a value cached under one appearance is
// not handed back under another, and comes back correct when the appearance does.
@Test
function theEnvironmentIsPartOfTheCacheKey() {
    let stack = stackOf(cacheRecord())
    var cache = makeDefaultCache()
    let lightValue = cache.color(stack, "label", light())
    let darkValue = cache.color(stack, "label", dark())
    let lightAgain = cache.color(stack, "label", light())
    expect!((colorsEqual(lightValue, color(0.0, 0.0, 0.0, 1.0))) == (true))
    expect!((colorsEqual(darkValue, color(1.0, 1.0, 1.0, 1.0))) == (true))
    expect!((colorsEqual(lightAgain, lightValue)) == (true))
}

@Test
function repeatedLookupIsServedFromTheCache() {
    let stack = stackOf(cacheRecord())
    var cache = makeDefaultCache()
    let _ = cache.color(stack, "label", light())
    let missesAfterFirst = cache.misses
    for index in 0..50 {
        let _ = cache.color(stack, "label", light())
    }
    expect!((cache.misses) == (missesAfterFirst))
    expect!((cache.hits >= 50) == (true))
    expect!((cache.hitRate() > 90) == (true))
}

// The same name under two kinds is two cache entries: a color lookup never
// answers with the material filed under that name.
@Test
function theResourceKindIsPartOfTheCacheKey() {
    var record = cacheRecord()
    var material = ResourceRecord()
    material.name = "label"
    material.kind = .Material
    var recipe = MaterialValue()
    recipe.layers.append(backdropBlurLayer(12.0))
    var rendition = RenditionRecord()
    rendition.payload = recipe.encoded()
    material.renditions.append(rendition)
    record.resources.append(material)

    let stack = stackOf(record)
    var cache = makeDefaultCache()
    let asColor = cache.color(stack, "label", light())
    let asMaterial = cache.resolve(stack, "label", .Material, light())
    expect!((colorsEqual(asColor, color(0.0, 0.0, 0.0, 1.0))) == (true))
    expect!((asMaterial.found) == (true))
    expect!((asMaterial.kind.equals(.Material)) == (true))
}

// A name nothing defines answers with the debug color from the cache too, and
// that answer is cached like any other.
@Test
function absentNameIsTheDebugColorThroughTheCache() {
    let stack = stackOf(cacheRecord())
    var cache = makeDefaultCache()
    let first = cache.color(stack, "noSuchThing", light())
    let second = cache.color(stack, "noSuchThing", light())
    expect!((colorsEqual(first, ResolverFallback.color)) == (true))
    expect!((colorsEqual(second, first)) == (true))
    expect!((cache.hits >= 1) == (true))
}

// Pushing a catalog can change what any name means, so the cache is dropped and
// the next answer comes from the new catalog.
@Test
function pushingACatalogDropsTheCache() {
    var resources = makeResources(catalogOf(cacheRecord()), light())
    let before = resources.color("label")

    var overlay = CatalogRecord()
    overlay.resources.append(flat("label", color(1.0, 0.0, 0.0, 1.0)))
    resources.pushCatalog(catalogOf(overlay))
    let after = resources.color("label")

    expect!((colorsEqual(before, color(0.0, 0.0, 0.0, 1.0))) == (true))
    expect!((colorsEqual(after, color(1.0, 0.0, 0.0, 1.0))) == (true))
    expect!((resources.cache.hits) == (0))
}

// An appearance change needs no invalidation at all: the same name answers
// differently for each appearance and identically when the appearance returns.
@Test
function changingTheAppearanceNeedsNoInvalidation() {
    var resources = makeResources(catalogOf(cacheRecord()), light())
    let lightValue = resources.color("accentColor")
    resources.setAppearance(.Dark)
    let darkValue = resources.color("accentColor")
    resources.setAppearance(.Light)
    let lightAgain = resources.color("accentColor")
    expect!((colorsEqual(lightValue, color(0.25, 0.5, 1.0, 1.0))) == (true))
    expect!((colorsEqual(darkValue, color(0.5, 0.75, 1.0, 1.0))) == (true))
    expect!((colorsEqual(lightAgain, lightValue)) == (true))
}

// A cache smaller than the working set still answers correctly; it only stops
// answering quickly.
@Test
function smallCacheStaysCorrectUnderEviction() {
    let stack = stackOf(cacheRecord())
    var cache = makeResolutionCache(16)
    for index in 0..200 {
        let value = cache.color(stack, "tint", dark())
        expect!((colorsEqual(value, color(0.5, 0.75, 1.0, 1.0))) == (true))
        let other = cache.color(stack, "label", light())
        expect!((colorsEqual(other, color(0.0, 0.0, 0.0, 1.0))) == (true))
    }
}

@Test
function freshCacheHasNoHitRate() {
    var cache = makeDefaultCache()
    expect!((cache.hitRate()) == (0))
    expect!((cache.hits) == (0))
    expect!((cache.misses) == (0))
}

@Test
function clearingTheCacheResetsItsCounters() {
    let stack = stackOf(cacheRecord())
    var cache = makeDefaultCache()
    let _ = cache.color(stack, "label", light())
    let _ = cache.color(stack, "label", light())
    cache.clear()
    expect!((cache.hits) == (0))
    expect!((cache.misses) == (0))
    expect!((cache.hitRate()) == (0))
}
