import Foundation
import KCoreUI

// The container: byte helpers, fixed point, text, and the round-trip property
// the whole design rests on.

// --- Byte helpers ----------------------------------------------------------

construct KcuLittleEndianWordsReadBack() extends Test {
    test {
        let bytes: [U8] = [0xEF, 0xBE, 0x78, 0x56, 0x34, 0x12]
        return readU16(bytes, 0) == 0xBEEF && readU32(bytes, 2) == 0x12345678
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuSignedWordsSignExtend() extends Test {
    test {
        let bytes: [U8] = [0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x80]
        return readI32(bytes, 0) == -1 && readI32(bytes, 4) == -2147483648
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuReadingPastTheEndAnswersZeroRatherThanTrapping() extends Test {
    test {
        let bytes: [U8] = [9]
        return readU32(bytes, 40) == 0 && readU8(bytes, -3) == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Fixed point -----------------------------------------------------------

construct KcuFixedPointRoundTripsAValueItCanRepresent() extends Test {
    test {
        return floatFromFixed(fixedFromNumber(0.5)) == 0.5
            && floatFromFixed(fixedFromNumber(-0.25)) == -0.25
            && floatFromFixed(fixedFromNumber(28.0)) == 28.0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A channel is stored to 1/65536, so a value authored in thousandths comes back
// within half a unit of the scale rather than exactly.
construct KcuFixedPointKeepsAuthoredChannelsWithinOneUnit() extends Test {
    test {
        let authored = 0.231
        let recovered = floatFromFixed(fixedFromNumber(authored))
        let error = recovered - authored
        return abs(error) < 0.00002
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuFixedPointRoundsAwayFromZeroOnBothSigns() extends Test {
    test {
        let positive = fixedFromNumber(1.5 / Number(FixedPoint.scale))
        let negative = fixedFromNumber((-1.5) / Number(FixedPoint.scale))
        return positive == 2 && negative == -2
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Text ------------------------------------------------------------------

construct KcuTextSurvivesTheByteRoundTrip() extends Test {
    test {
        let original = "systemGroupedBackground"
        return compareStrings(stringFromBytes(stringBytes(original)), original) == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuMultiByteTextSurvivesTheByteRoundTrip() extends Test {
    test {
        let original = "café 中文 😀"
        return compareStrings(stringFromBytes(stringBytes(original)), original) == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuNamesCompareAsBytesWithoutBeingRebuilt() extends Test {
    test {
        let bytes = stringBytes("separator")
        return compareSliceToString(bytes, 0, bytes.count, "separator") == 0
            && compareSliceToString(bytes, 0, bytes.count, "separatorX") < 0
            && compareSliceToString(bytes, 0, bytes.count, "sepa") > 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Round trip ------------------------------------------------------------

function mixedRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", color(0.1, 0.1, 0.1, 1.0), color(0.9, 0.9, 0.9, 1.0)))
    record.resources.append(flat("separator", color(0.0, 0.0, 0.0, 0.1)))
    record.resources.append(alias("foreground", "label"))
    return record
}

construct KcuWritingAndReadingBackReproducesTheBytes() extends Test {
    test { return roundTrips(mixedRecord()) }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuAnEmptyCatalogRoundTrips() extends Test {
    test { return roundTrips(CatalogRecord()) }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The property that makes an editor safe: a resource whose kind this build has
// no decoder for is carried through load and write-back untouched.
construct KcuAnUndecodableKindSurvivesTheRoundTrip() extends Test {
    test {
        var record = mixedRecord()
        record.resources.append(opaqueResource("somethingElse"))
        return roundTrips(record)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuAnUndecodableKindKeepsItsPayloadBytes() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(opaqueResource("somethingElse"))
        let catalog = catalogOf(record)
        let index = catalog.findResource("somethingElse", unknownKind())
        if index < 0 {
            return false
        }
        let stored = catalog.renditionPayload(catalog.resources[index].firstRendition)
        return bytesEqual(stored, opaqueResource("x").renditions[0].payload)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Canonical output: the same resources given in a different order produce the
// same file, so two producers cannot disagree about the bytes.
construct KcuResourceOrderDoesNotChangeTheBytes() extends Test {
    test {
        var forward = CatalogRecord()
        forward.resources.append(flat("alpha", color(1.0, 0.0, 0.0, 1.0)))
        forward.resources.append(flat("beta", color(0.0, 1.0, 0.0, 1.0)))
        forward.resources.append(flat("gamma", color(0.0, 0.0, 1.0, 1.0)))

        var backward = CatalogRecord()
        backward.resources.append(flat("gamma", color(0.0, 0.0, 1.0, 1.0)))
        backward.resources.append(flat("beta", color(0.0, 1.0, 0.0, 1.0)))
        backward.resources.append(flat("alpha", color(1.0, 0.0, 0.0, 1.0)))

        return bytesEqual(forward.encoded(), backward.encoded())
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuRenditionOrderDoesNotChangeTheBytes() extends Test {
    test {
        var forward = CatalogRecord()
        forward.resources.append(
            adaptive("label", color(0.1, 0.1, 0.1, 1.0), color(0.9, 0.9, 0.9, 1.0))
        )

        var swapped = ResourceRecord()
        swapped.name = "label"
        swapped.kind = .Color
        var darkFirst = RenditionRecord()
        darkFirst.constraints.append(Appearance.Dark.constraint())
        darkFirst.payload = authored(color(0.9, 0.9, 0.9, 1.0))
        swapped.renditions.append(darkFirst)
        var lightSecond = RenditionRecord()
        lightSecond.constraints.append(Appearance.Light.constraint())
        lightSecond.payload = authored(color(0.1, 0.1, 0.1, 1.0))
        swapped.renditions.append(lightSecond)

        var backward = CatalogRecord()
        backward.resources.append(swapped)
        return bytesEqual(forward.encoded(), backward.encoded())
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// One name may carry several kinds, because a resource is keyed by both.
construct KcuOneNameCarriesSeveralKinds() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(flat("regular", color(0.5, 0.5, 0.5, 1.0)))

        var material = ResourceRecord()
        material.name = "regular"
        material.kind = .Material
        var recipe = MaterialValue()
        recipe.layers.append(backdropBlurLayer(28.0))
        var rendition = RenditionRecord()
        rendition.payload = recipe.encoded()
        material.renditions.append(rendition)
        record.resources.append(material)

        let catalog = catalogOf(record)
        return catalog.findResource("regular", .Color) >= 0
            && catalog.findResource("regular", .Material) >= 0
            && roundTrips(record)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
