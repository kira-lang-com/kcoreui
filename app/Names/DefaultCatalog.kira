// The shipped catalog's bytes.
function defaultCatalogBytes() -> [U8] {
    var bytes: [U8] = []
    for chunk in defaultCatalogChunks() {
        appendHexBytes(bytes, chunk)
    }
    return bytes
}

// The catalog every stack is founded on.
//
// Parsed rather than trusted: the embedded bytes go through the same parser a
// blob off disk does, so the floor cannot be the one catalog in the system
// that was never checked. A build whose generated source has been damaged
// answers an empty catalog, and the integrity check fails loudly.
function defaultCatalog() -> Catalog {
    attempt {
        let catalog = try parseCatalog(defaultCatalogBytes())
        return catalog
    } handle {
        NotKira { return Catalog() }
        UnsupportedVersion { return Catalog() }
        TruncatedHeader { return Catalog() }
        TruncatedTable { return Catalog() }
        OffsetOutOfRange { return Catalog() }
        NamesUnsorted { return Catalog() }
        ConstraintsUnsorted { return Catalog() }
        DuplicateRendition { return Catalog() }
        ReservedTraitValue { return Catalog() }
    }
}

// Resources founded on the shipped catalog. What a toolkit calls once at
// start-up, before it has any blob of its own to put above it.
function makeDefaultResources(environment: borrow UIEnvironment) -> UIResources {
    return makeResources(defaultCatalog(), environment)
}
