import Foundation
import KCoreUI

// The catalog this repository ships.
//
// These cases read `Resources/Default.kcui` off disk, through the same parser
// an application uses. The integrity case is the load-bearing one: it is what
// lets the rest of the framework promise that resolution is total, because it
// proves the floor answers for every name the hardcoded surface declares.

construct KcuTheDefaultCatalogLoads() extends Test {
    test { return defaultCatalog().resources.count > 0 }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Fractional Number midpoints must not cause the lookup to skip a resource.
construct KcuEveryDefaultCatalogResourceCanBeFound() extends Test {
    test {
        let catalog = defaultCatalog()
        for index in 0..catalog.resources.count {
            let name = catalog.resourceName(index)
            if catalog.findResource(name, catalog.resources[index].kind) != index {
                return false
            }
        }
        return true
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The shipped blob is canonical, so an editor that opens and saves it without
// changing anything writes the same file back.
construct KcuTheDefaultCatalogWritesBackByteForByte() extends Test {
    test {
        match defaultCatalogBytes() {
            Ok(bytes) -> return bytesEqual(bytes, (defaultCatalog()).encoded())
            Error(failure) -> return "unreadable: \(failure)"
        }
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The contract between the hardcoded name surface and the shipped catalog. A
// name declared with nothing behind it would resolve through the floor and
// paint the debug color.
construct KcuTheDefaultCatalogCoversEveryDeclaredName() extends Test {
    test { return ((defaultCatalog()).checkIntegrity()).holds() }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuTheDefaultCatalogDeclaresNothingItDoesNotCarry() extends Test {
    test {
        let report = (defaultCatalog()).checkIntegrity()
        return report.missingColors.count + report.missingMaterials.count + report.missingTextStyles.count
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(0)
        return e
    }
}

// Every declared color answers in both appearances and in high contrast. This
// is the case that would catch a rendition set that covers light and forgets
// dark.
construct KcuEveryDeclaredColorResolvesInEveryAppearance() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var complete = true
        for name in ColorName.all {
            if !stack.resolveColorChecked(name, light()).found { complete = false }
            if !stack.resolveColorChecked(name, dark()).found { complete = false }
            if !stack.resolveColorChecked(name, lightHighContrast()).found { complete = false }
        }
        return complete
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuEveryDeclaredMaterialResolvesInEveryAppearance() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var complete = true
        for name in MaterialName.all {
            if !stack.resolveMaterial(name, light()).found { complete = false }
            if !stack.resolveMaterial(name, dark()).found { complete = false }
            if !stack.resolveMaterial(name, reducedTransparency()).found { complete = false }
        }
        return complete
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuEveryDeclaredTextStyleResolves() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var complete = true
        for name in TextStyleName.all {
            let resolved = stack.resolveTypography(name, light())
            if !resolved.found || resolved.value.size <= 0.0 || resolved.value.lineHeight <= 0.0 {
                complete = false
            }
        }
        return complete
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A label that did not change between appearances would mean the catalog is
// carrying one value under two renditions.
construct KcuTheLabelColorDiffersBetweenAppearances() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let light = stack.resolveColor(ColorName.label, light())
        let dark = stack.resolveColor(ColorName.label, dark())
        return !colorsEqual(light, dark) && light.r < dark.r
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Apple's hierarchical styles are aliases in the shipped catalog, so they track
// the labels they name in every appearance without a second set of numbers.
construct KcuTheHierarchicalStylesAliasTheLabels() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var agrees = true
        if !colorsEqual(
            stack.resolveColor(ColorName.primary, dark()),
            stack.resolveColor(ColorName.label, dark())
        ) {
            agrees = false
        }
        if !colorsEqual(
            stack.resolveColor(ColorName.foreground, light()),
            stack.resolveColor(ColorName.label, light())
        ) {
            agrees = false
        }
        if !colorsEqual(
            stack.resolveColor(ColorName.accentColor, dark()),
            stack.resolveColor(ColorName.tint, dark())
        ) {
            agrees = false
        }
        return agrees
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The material ladder gets thicker, and its tint follows the appearance because
// the recipe names a color rather than carrying one.
construct KcuTheMaterialLadderThickensAndFollowsTheAppearance() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let thin = stack.resolveMaterial(MaterialName.ultraThin, light())
        let thick = stack.resolveMaterial(MaterialName.ultraThick, light())
        if thin.blurRadius() >= thick.blurRadius() {
            return false
        }
        let lightRegular = stack.resolveMaterial(MaterialName.regular, light())
        let darkRegular = stack.resolveMaterial(MaterialName.regular, dark())
        let background = stack.resolveColor(ColorName.systemBackground, dark())
        return colorsEqual(darkRegular.layers[2].color, background)
            && !colorsEqual(lightRegular.layers[2].color, darkRegular.layers[2].color)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Reduced transparency swaps the recipe rather than dimming it.
construct KcuReducedTransparencyRemovesTheBlurFromEveryMaterial() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var opaque = true
        for name in MaterialName.all {
            if (stack.resolveMaterial(name, reducedTransparency())).blurRadius() != 0.0 {
                opaque = false
            }
        }
        return opaque
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The bar is the only material in the ladder that draws its own hairline.
construct KcuOnlyTheBarMaterialCarriesABorder() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        var borders = 0
        for name in MaterialName.all {
            for layer in stack.resolveMaterial(name, light()).layers {
                if layer.kind == .Border {
                    borders++
                }
            }
        }
        return borders
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

// The declared order is Apple's vocabulary order, which is not sorted by size:
// `subheadline` is 13pt and the `body` after it is 15pt. What the ladder does
// promise is that every style is usable and that the ends of it bracket the
// rest.
construct KcuTheTextLadderBracketsEveryStyle() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let largest = stack.resolveTypography(TextStyleName.largeTitle, light()).value.size
        let smallest = stack.resolveTypography(TextStyleName.caption2, light()).value.size
        var bracketed = largest > smallest
        for name in TextStyleName.all {
            let style = stack.resolveTypography(name, light()).value
            if style.size > largest || style.size < smallest {
                bracketed = false
            }
            if style.lineHeight < style.size {
                bracketed = false
            }
        }
        return bracketed
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The kit's body style: 17 on a 22 line, regular. A change here means the
// toolkit's text would move.
construct KcuTheBodyStyleKeepsTheKitsMetrics() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let body = stack.resolveTypography(TextStyleName.body, tablet()).value
        return body.size == 17.0 && body.lineHeight == 22.0 && body.weight == 400
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuADesktopSetsTheBodyStyleAtTheMacsSize() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let body = stack.resolveTypography(TextStyleName.body, desktop()).value
        return body.size == 13.0 && body.lineHeight == 16.0 && body.weight == 400
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A Mac's sidebar row is AppKit's medium row, 32 since macOS 26; its push
// moves on the same spring as the kit's.
construct KcuADesktopLaysOutAtTheMacsSizeAndMovesAtTheKitsPace() extends Test {
    test {
        let stack = (defaultCatalog()).asStack()
        let tabletRow = stack.resolveMetric(MetricName.sidebarRowHeight, tablet()).points
        let desktopRow = stack.resolveMetric(MetricName.sidebarRowHeight, desktop()).points
        let tabletPush = stack.resolveMetric(MetricName.navigationPushResponse, tablet()).points
        let desktopPush = stack.resolveMetric(MetricName.navigationPushResponse, desktop()).points
        return tabletRow == 44.0 && desktopRow == 32.0 && tabletPush == desktopPush
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
