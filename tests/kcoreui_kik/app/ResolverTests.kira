import Foundation
import KCoreUI

// The matching rules.
//
// Eligibility and specificity are the whole resolver, and both have to be total
// and deterministic or a catalog resolves one way on the VM and another under
// LLVM. Each case here pins one clause of those two rules.

function rendition(color: borrow RGBAColor) -> RenditionRecord {
    var rendition = RenditionRecord()
    rendition.payload = authored(color)
    return rendition
}

function constrained(
    color: borrow RGBAColor,
    constraints: borrow [CatalogConstraint]
) -> RenditionRecord {
    var rendition = rendition(color)
    for entry in constraints {
        rendition.constraints.append(entry)
    }
    return rendition
}

function one(entry: borrow CatalogConstraint) -> [CatalogConstraint] {
    var list: [CatalogConstraint] = []
    list.append(entry)
    return list
}

function two(
    first: borrow CatalogConstraint,
    second: borrow CatalogConstraint
) -> [CatalogConstraint] {
    var list = one(first)
    list.append(second)
    return list
}

namespace TestColor {
    let red: RGBAColor = color(1.0, 0.0, 0.0, 1.0)
    let green: RGBAColor = color(0.0, 1.0, 0.0, 1.0)
    let blue: RGBAColor = color(0.0, 0.0, 1.0, 1.0)
    let white: RGBAColor = color(1.0, 1.0, 1.0, 1.0)
}

// --- Eligibility -----------------------------------------------------------

construct KcuTheAppearanceSelectsTheRendition() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(adaptive("label", TestColor.red, TestColor.blue))
        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("label", light()), TestColor.red)
            && colorsEqual(stack.resolveColor("label", dark()), TestColor.blue)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A rendition that pins nothing matches every environment, which is what makes
// a single-value resource possible.
construct KcuAnUnconstrainedRenditionServesEveryEnvironment() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(flat("separator", TestColor.green))
        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("separator", light()), TestColor.green)
            && colorsEqual(stack.resolveColor("separator", dark()), TestColor.green)
            && colorsEqual(stack.resolveColor("separator", lightHighContrast()), TestColor.green)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Specificity -----------------------------------------------------------

// A rendition pinning two traits beats one pinning a subset of them, whenever
// both are eligible.
construct KcuMoreConstraintsWinWhenBothAreEligible() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        resource.renditions.append(constrained(TestColor.red, one(Appearance.Light.constraint())))
        resource.renditions.append(
            constrained(
                TestColor.green,
                two(Appearance.Light.constraint(), Contrast.High.constraint())
            )
        )
        var record = CatalogRecord()
        record.resources.append(resource)

        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("label", lightHighContrast()), TestColor.green)
            && colorsEqual(stack.resolveColor("label", light()), TestColor.red)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Priority is the trait numbering. Appearance is identifier zero, so a
// rendition pinning it beats one pinning only contrast even though both pin
// exactly one trait and both are eligible.
construct KcuTheLowerTraitIdentifierWinsAtEqualCount() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        resource.renditions.append(constrained(TestColor.red, one(Appearance.Light.constraint())))
        resource.renditions.append(constrained(TestColor.blue, one(Contrast.Standard.constraint())))
        var record = CatalogRecord()
        record.resources.append(resource)

        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("label", light()), TestColor.red)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The order renditions were authored in cannot change the answer, because the
// writer sorts them into one canonical arrangement.
construct KcuAuthoringOrderDoesNotChangeTheWinner() extends Test {
    test {
        var forward = ResourceRecord()
        forward.name = "label"
        forward.kind = .Color
        forward.renditions.append(constrained(TestColor.red, one(Appearance.Light.constraint())))
        forward.renditions.append(
            constrained(
                TestColor.green,
                two(Appearance.Light.constraint(), Contrast.High.constraint())
            )
        )

        var backward = ResourceRecord()
        backward.name = "label"
        backward.kind = .Color
        backward.renditions.append(
            constrained(
                TestColor.green,
                two(Appearance.Light.constraint(), Contrast.High.constraint())
            )
        )
        backward.renditions.append(constrained(TestColor.red, one(Appearance.Light.constraint())))

        var first = CatalogRecord()
        first.resources.append(forward)
        var second = CatalogRecord()
        second.resources.append(backward)

        let left = (stackOf(first)).resolveColor("label", lightHighContrast())
        let right = (stackOf(second)).resolveColor("label", lightHighContrast())
        return colorsEqual(left, right) && colorsEqual(left, TestColor.green)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Custom traits ---------------------------------------------------------

namespace TestTrait {
    let brand: TraitIdentifier = .Custom(TraitIdentifierRange.customBase + 3)
}

function brandedEnvironment(value: Number) -> UIEnvironment {
    var environment = light()
    environment.custom.append(CustomTrait(identifier: TestTrait.brand, value: value))
    return environment
}

function brandedRecord() -> CatalogRecord {
    var resource = ResourceRecord()
    resource.name = "tint"
    resource.kind = .Color
    resource.renditions.append(rendition(TestColor.blue))
    resource.renditions.append(constrained(TestColor.red, one((TestTrait.brand).constrain(2))))
    var record = CatalogRecord()
    record.resources.append(resource)
    return record
}

// A rendition pinning a trait the environment does not carry is not a match.
// That is what keeps a producer's own traits from leaking into an environment
// that never heard of them.
construct KcuACustomTraitIsInvisibleToAnEnvironmentWithoutIt() extends Test {
    test {
        let stack = stackOf(brandedRecord())
        return colorsEqual(stack.resolveColor("tint", light()), TestColor.blue)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuACustomTraitSelectsWhenTheEnvironmentCarriesIt() extends Test {
    test {
        let stack = stackOf(brandedRecord())
        return colorsEqual(stack.resolveColor("tint", brandedEnvironment(2)), TestColor.red)
            && colorsEqual(stack.resolveColor("tint", brandedEnvironment(9)), TestColor.blue)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Custom traits are part of the cache key, so two environments differing only
// in one do not share an answer.
construct KcuCustomTraitsChangeTheEnvironmentKey() extends Test {
    test {
        return (brandedEnvironment(2)).customKey() != (brandedEnvironment(9)).customKey()
            && (light()).customKey() == UICustomTraitKey(0)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Stacks ----------------------------------------------------------------

function floorRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", TestColor.red, TestColor.blue))
    record.resources.append(flat("separator", TestColor.green))
    return record
}

construct KcuAnOverlayOverridesTheFloor() extends Test {
    test {
        var overlay = CatalogRecord()
        overlay.resources.append(flat("label", TestColor.white))
        let stack = (stackOf(floorRecord())).overlaid(catalogOf(overlay))
        return colorsEqual(stack.resolveColor("label", light()), TestColor.white)
            && colorsEqual(stack.resolveColor("separator", light()), TestColor.green)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The whole override story: a partial blob names three colors and changes
// three colors. Nothing else in the catalog moves, and no override API exists.
construct KcuAPartialOverlayLeavesEverythingElseAlone() extends Test {
    test {
        var overlay = CatalogRecord()
        overlay.resources.append(flat("separator", TestColor.white))
        let stack = (stackOf(floorRecord())).overlaid(catalogOf(overlay))
        return colorsEqual(stack.resolveColor("separator", dark()), TestColor.white)
            && colorsEqual(stack.resolveColor("label", dark()), TestColor.blue)
            && stack.depth() == 2
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// An overlay that names a resource but has no rendition eligible for this
// environment does not stop the search. Overriding dark alone is safe.
construct KcuAnOverlayThatCannotAnswerFallsThroughToTheFloor() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        resource.renditions.append(constrained(TestColor.white, one(Appearance.Dark.constraint())))
        var overlay = CatalogRecord()
        overlay.resources.append(resource)

        let stack = (stackOf(floorRecord())).overlaid(catalogOf(overlay))
        return colorsEqual(stack.resolveColor("label", dark()), TestColor.white)
            && colorsEqual(stack.resolveColor("label", light()), TestColor.red)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A resource of another kind under the same name does not shadow, because a
// resource is keyed by name and kind together.
construct KcuAnotherKindUnderTheSameNameDoesNotShadow() extends Test {
    test {
        var material = ResourceRecord()
        material.name = "label"
        material.kind = .Material
        var recipe = MaterialValue()
        recipe.layers.append(backdropBlurLayer(10.0))
        var rendition = RenditionRecord()
        rendition.payload = recipe.encoded()
        material.renditions.append(rendition)

        var overlay = CatalogRecord()
        overlay.resources.append(material)
        let stack = (stackOf(floorRecord())).overlaid(catalogOf(overlay))
        return colorsEqual(stack.resolveColor("label", light()), TestColor.red)
            && (makeResources(catalogOf(overlay), light())).material("label").found
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Absence ---------------------------------------------------------------

construct KcuAnUnknownNameResolvesToTheDebugColor() extends Test {
    test {
        let stack = stackOf(floorRecord())
        let resolution = stack.resolveColorChecked("noSuchThing", light())
        return !resolution.found && colorsEqual(resolution.color, ResolverFallback.color)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Tracing ---------------------------------------------------------------

construct KcuATraceReportsWhichRenditionWon() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        resource.renditions.append(constrained(TestColor.red, one(Appearance.Light.constraint())))
        resource.renditions.append(
            constrained(
                TestColor.green,
                two(Appearance.Light.constraint(), Contrast.High.constraint())
            )
        )
        var record = CatalogRecord()
        record.resources.append(resource)

        let trace = (stackOf(record)).traceResolution("label", .Color, lightHighContrast())
        return trace.found
            && trace.candidatesConsidered == 2
            && trace.candidatesEligible == 2
            && trace.matchedConstraints.count == 2
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuATraceOfAnAbsentNameReportsNothingMatched() extends Test {
    test {
        let trace = (stackOf(floorRecord())).traceResolution("noSuchThing", .Color, light())
        return !trace.found && trace.catalogsSearched == 1
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
