import Foundation
import KCoreUI

// The default catalog's colors.
//
// Values are Apple's, read off the variables of the iOS and iPadOS 27 design
// kit: every name below is one of the kit's color variables, quoted in its
// light and dark modes. The kit dropped its increased-contrast mode, so these
// resources carry an appearance pair. Where a Mac paints a name in its own
// values -- the label ladder, the fills, the separator -- the resource carries a
// desktop pair too, read off SwiftUI's shape styles and AppKit's colors on
// macOS 27. What Apple has no word for sits at the end of the file, under the
// toolkit's own names.
//
// A name that means the same thing as another is written as a reference, not as
// a second copy of the numbers. `foreground` is `label`, and stays `label` in
// dark appearance, in high contrast, and in whatever a future override says,
// because the reference is resolved against the same environment the material
// or the caller resolved against.

// A color quoted in sRGB, stored as the Display P3 the catalog holds.
//
// Every number below came from a design tool or from KiraUI's own tokens, and
// both quote sRGB. The catalog is Display P3, so the conversion happens here,
// once, at authoring — not at resolve, where it would be a guess about what the
// stored numbers had meant.
//
// The two spaces share a transfer curve and a white point, so this is a matrix
// in linear light and nothing is lost: every sRGB color is inside P3.
function rgba(r: Number, g: Number, b: Number, a: Number) -> RGBAColor {
    return (RGBAColor(r: r, g: g, b: b, a: a)).srgbToP3()
}

// The same, with the channels in the 0–255 the kit quotes them in, so each
// number below reads exactly as it does in the design file.
function rgba255(r: Number, g: Number, b: Number, a: Number) -> RGBAColor {
    return rgba(r / 255.0, g / 255.0, b / 255.0, a)
}

// A color with a light and a dark rendition, which is the shape almost every
// resource in the catalog has.
function adaptiveColor(
    name: borrow String,
    light: borrow RGBAColor,
    dark: borrow RGBAColor
) -> ResourceRecord {
    var resource = ResourceRecord()
    resource.name = name
    resource.kind = .Color

    var lightRendition = RenditionRecord()
    lightRendition.constraints.append(Appearance.Light.constraint())
    lightRendition.payload = encodeColor(light)
    resource.renditions.append(lightRendition)

    var darkRendition = RenditionRecord()
    darkRendition.constraints.append(Appearance.Dark.constraint())
    darkRendition.payload = encodeColor(dark)
    resource.renditions.append(darkRendition)
    return resource
}

// A color a Mac paints in its own values: the light and dark renditions above,
// and a light and a dark rendition for the desktop idiom, which win there.
function sizedAdaptiveColor(
    name: borrow String,
    light: borrow RGBAColor,
    dark: borrow RGBAColor,
    desktopLight: borrow RGBAColor,
    desktopDark: borrow RGBAColor
) -> ResourceRecord {
    var resource = adaptiveColor(name, light, dark)

    var lightRendition = RenditionRecord()
    lightRendition.constraints.append(Appearance.Light.constraint())
    lightRendition.constraints.append(Idiom.Desktop.constraint())
    lightRendition.payload = encodeColor(desktopLight)
    resource.renditions.append(lightRendition)

    var darkRendition = RenditionRecord()
    darkRendition.constraints.append(Appearance.Dark.constraint())
    darkRendition.constraints.append(Idiom.Desktop.constraint())
    darkRendition.payload = encodeColor(desktopDark)
    resource.renditions.append(darkRendition)
    return resource
}

// One name meaning another. No constraints, because an alias holds under every
// environment: what varies is what it points at.
function aliasColor(name: borrow String, target: borrow String) -> ResourceRecord {
    var resource = ResourceRecord()
    resource.name = name
    resource.kind = .Color
    var rendition = RenditionRecord()
    rendition.payload = encodeColorAlias(target)
    resource.renditions.append(rendition)
    return resource
}

// --- The system palette ----------------------------------------------------
//
// The kit's `Accents` and `Grays` collections.

function paletteResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(
        adaptiveColor(
            ColorName.systemRed,
            rgba255(255.0, 56.0, 60.0, 1.0),
            rgba255(255.0, 66.0, 69.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemOrange,
            rgba255(255.0, 141.0, 40.0, 1.0),
            rgba255(255.0, 146.0, 48.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemYellow,
            rgba255(255.0, 204.0, 0.0, 1.0),
            rgba255(255.0, 214.0, 0.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemGreen,
            rgba255(52.0, 199.0, 89.0, 1.0),
            rgba255(48.0, 209.0, 88.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemMint,
            rgba255(0.0, 200.0, 179.0, 1.0),
            rgba255(0.0, 218.0, 195.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemTeal,
            rgba255(0.0, 195.0, 208.0, 1.0),
            rgba255(0.0, 210.0, 224.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemCyan,
            rgba255(0.0, 192.0, 232.0, 1.0),
            rgba255(60.0, 211.0, 254.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemBlue,
            rgba255(0.0, 136.0, 255.0, 1.0),
            rgba255(0.0, 145.0, 255.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemIndigo,
            rgba255(97.0, 85.0, 245.0, 1.0),
            rgba255(109.0, 124.0, 255.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemPurple,
            rgba255(203.0, 48.0, 224.0, 1.0),
            rgba255(219.0, 52.0, 242.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemPink,
            rgba255(255.0, 45.0, 85.0, 1.0),
            rgba255(255.0, 55.0, 95.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemBrown,
            rgba255(172.0, 127.0, 94.0, 1.0),
            rgba255(183.0, 138.0, 102.0, 1.0)
        )
    )

    records.append(
        adaptiveColor(
            ColorName.systemGray,
            rgba255(142.0, 142.0, 147.0, 1.0),
            rgba255(142.0, 142.0, 147.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemGray2,
            rgba255(174.0, 174.0, 178.0, 1.0),
            rgba255(99.0, 99.0, 102.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.systemGray3,
            rgba255(199.0, 199.0, 204.0, 1.0),
            rgba255(72.0, 72.0, 74.0, 1.0)
