import Foundation

// Apple's color vocabulary, in SwiftUI's spelling.
//
// These are names, not values. Nothing here says what `label` looks like; a
// catalog does, and a different catalog says something else. Swapping the whole
// vocabulary is a different blob and no code change, which is what keeps this
// file a cheap decision rather than a permanent one.
//
// Nothing in `app/Core` may import this. The format, the parser and the
// resolver never learn a single name, which is what lets them carry a
// vocabulary they have never heard of.
//
// AppKit's spelling is not carried alongside UIKit's. Apple ships the same
// concept twice — `labelColor` against `label`, `controlBackgroundColor`
// against `systemBackground` — and two names for one resource is two chances
// for a catalog to define only one of them.
//
// The Kira identifiers are prefixed; the resource names they answer are flat,
// exactly as Apple writes them.

// --- Hierarchical styles ---------------------------------------------------

public function colorPrimary() -> String { return "primary" }
public function colorSecondary() -> String { return "secondary" }
public function colorTertiary() -> String { return "tertiary" }
public function colorQuaternary() -> String { return "quaternary" }
public function colorQuinary() -> String { return "quinary" }

// --- Labels ----------------------------------------------------------------

public function colorLabel() -> String { return "label" }
public function colorSecondaryLabel() -> String { return "secondaryLabel" }
public function colorTertiaryLabel() -> String { return "tertiaryLabel" }
public function colorQuaternaryLabel() -> String { return "quaternaryLabel" }
public function colorPlaceholderText() -> String { return "placeholderText" }
public function colorPlaceholder() -> String { return "placeholder" }

// --- Fills -----------------------------------------------------------------

public function colorSystemFill() -> String { return "systemFill" }
public function colorSecondarySystemFill() -> String { return "secondarySystemFill" }
public function colorTertiarySystemFill() -> String { return "tertiarySystemFill" }
public function colorQuaternarySystemFill() -> String { return "quaternarySystemFill" }
public function colorFill() -> String { return "fill" }

// --- Backgrounds -----------------------------------------------------------

public function colorSystemBackground() -> String { return "systemBackground" }
public function colorSecondarySystemBackground() -> String { return "secondarySystemBackground" }
public function colorTertiarySystemBackground() -> String { return "tertiarySystemBackground" }
public function colorSystemGroupedBackground() -> String { return "systemGroupedBackground" }
public function colorSecondarySystemGroupedBackground() -> String { return "secondarySystemGroupedBackground" }
public function colorTertiarySystemGroupedBackground() -> String { return "tertiarySystemGroupedBackground" }
public function colorBackground() -> String { return "background" }
public function colorWindowBackground() -> String { return "windowBackground" }

// --- Separators and links --------------------------------------------------

public function colorSeparator() -> String { return "separator" }
public function colorOpaqueSeparator() -> String { return "opaqueSeparator" }
public function colorLink() -> String { return "link" }

// --- Scroll indicators -------------------------------------------------------

public function colorScrollIndicator() -> String { return "scrollIndicator" }
public function colorScrollEdgeFill() -> String { return "scrollEdgeFill" }
public function colorScrollEdgeBorder() -> String { return "scrollEdgeBorder" }
public function colorSidebarShadow() -> String { return "sidebarShadow" }

// --- Shape styles ----------------------------------------------------------

public function colorForeground() -> String { return "foreground" }
public function colorSelection() -> String { return "selection" }
public function colorTint() -> String { return "tint" }
public function colorAccentColor() -> String { return "accentColor" }

// --- The system palette ----------------------------------------------------

public function colorSystemRed() -> String { return "systemRed" }
public function colorSystemOrange() -> String { return "systemOrange" }
public function colorSystemYellow() -> String { return "systemYellow" }
public function colorSystemGreen() -> String { return "systemGreen" }
public function colorSystemMint() -> String { return "systemMint" }
public function colorSystemTeal() -> String { return "systemTeal" }
public function colorSystemCyan() -> String { return "systemCyan" }
public function colorSystemBlue() -> String { return "systemBlue" }
public function colorSystemIndigo() -> String { return "systemIndigo" }
public function colorSystemPurple() -> String { return "systemPurple" }
public function colorSystemPink() -> String { return "systemPink" }
public function colorSystemBrown() -> String { return "systemBrown" }

public function colorSystemGray() -> String { return "systemGray" }
public function colorSystemGray2() -> String { return "systemGray2" }
public function colorSystemGray3() -> String { return "systemGray3" }
public function colorSystemGray4() -> String { return "systemGray4" }
public function colorSystemGray5() -> String { return "systemGray5" }
public function colorSystemGray6() -> String { return "systemGray6" }

// --- The whole surface -----------------------------------------------------

// Every color name this build declares.
//
// The integrity check walks this list against the default catalog, which is
// what stops the hardcoded surface and the shipped blob from drifting: a name
// here with no resource behind it is a lookup that would fall through the floor,
// and the floor is what makes resolution total.
public function allColorNames() -> [String] {
    var names: [String] = []
    names.append(colorPrimary())
    names.append(colorSecondary())
    names.append(colorTertiary())
    names.append(colorQuaternary())
    names.append(colorQuinary())

    names.append(colorLabel())
    names.append(colorSecondaryLabel())
    names.append(colorTertiaryLabel())
    names.append(colorQuaternaryLabel())
    names.append(colorPlaceholderText())
    names.append(colorPlaceholder())

    names.append(colorSystemFill())
    names.append(colorSecondarySystemFill())
    names.append(colorTertiarySystemFill())
    names.append(colorQuaternarySystemFill())
    names.append(colorFill())

    names.append(colorSystemBackground())
    names.append(colorSecondarySystemBackground())
    names.append(colorTertiarySystemBackground())
    names.append(colorSystemGroupedBackground())
    names.append(colorSecondarySystemGroupedBackground())
    names.append(colorTertiarySystemGroupedBackground())
    names.append(colorBackground())
    names.append(colorWindowBackground())

    names.append(colorSeparator())
    names.append(colorOpaqueSeparator())
    names.append(colorLink())
    names.append(colorScrollIndicator())
    names.append(colorScrollEdgeFill())
    names.append(colorScrollEdgeBorder())
    names.append(colorSidebarShadow())

    names.append(colorForeground())
    names.append(colorSelection())
    names.append(colorTint())
    names.append(colorAccentColor())

    names.append(colorSystemRed())
    names.append(colorSystemOrange())
    names.append(colorSystemYellow())
    names.append(colorSystemGreen())
    names.append(colorSystemMint())
    names.append(colorSystemTeal())
    names.append(colorSystemCyan())
    names.append(colorSystemBlue())
    names.append(colorSystemIndigo())
    names.append(colorSystemPurple())
    names.append(colorSystemPink())
    names.append(colorSystemBrown())

    names.append(colorSystemGray())
    names.append(colorSystemGray2())
    names.append(colorSystemGray3())
    names.append(colorSystemGray4())
    names.append(colorSystemGray5())
    names.append(colorSystemGray6())
    return names
}
