import Foundation

// The contract between the hardcoded name surface and a shipped catalog.
//
// The surface is code and the catalog is data, so nothing but a check keeps
// them agreeing. A name declared with no resource behind it resolves through
// the floor and paints the debug colour; a resource in the catalog that no name
// declares is merely unused. The first is a defect and the second is not, which
// is why they are reported separately.
//
// The test package runs this against the default catalog on every build. It is
// the whole reason the floor can be promised to be complete.

struct IntegrityReport {
    var missingColors: [String] = []
    var missingMaterials: [String] = []
    var missingTextStyles: [String] = []
    var missingMetrics: [String] = []
    var missingGlass: [String] = []
    var undeclaredColors: [String] = []
    var undeclaredMaterials: [String] = []
    var undeclaredTextStyles: [String] = []
    var undeclaredMetrics: [String] = []
    var undeclaredGlass: [String] = []
}

// Whether every declared name has a resource behind it. Undeclared extras do
// not fail: a catalog is allowed to carry more than this build knows about.
function integrityHolds(report: borrow IntegrityReport) -> Bool {
    if report.missingColors.count > 0 { return false }
    if report.missingMaterials.count > 0 { return false }
    if report.missingTextStyles.count > 0 { return false }
    if report.missingMetrics.count > 0 { return false }
    return report.missingGlass.count == 0
}

function checkIntegrity(catalog: borrow Catalog) -> IntegrityReport {
    var report = IntegrityReport()
    let colors = allColorNames()
    let materials = allMaterialNames()
    let textStyles = allTextStyleNames()
    let metrics = allMetricNames()
    let glass = allGlassNames()
    report.missingColors = missingNames(catalog, colors, .Color)
    report.missingMaterials = missingNames(catalog, materials, .Material)
    report.missingTextStyles = missingNames(catalog, textStyles, .Typography)
    report.missingMetrics = missingNames(catalog, metrics, .Metric)
    report.missingGlass = missingNames(catalog, glass, .Glass)
    report.undeclaredColors = undeclaredNames(catalog, colors, .Color)
    report.undeclaredMaterials = undeclaredNames(catalog, materials, .Material)
    report.undeclaredTextStyles = undeclaredNames(catalog, textStyles, .Typography)
    report.undeclaredMetrics = undeclaredNames(catalog, metrics, .Metric)
    report.undeclaredGlass = undeclaredNames(catalog, glass, .Glass)
    return report
}

function appendNameList(text: borrow String, label: borrow String, names: borrow [String]) -> String {
    if names.count == 0 {
        return text
    }
    var built = text + label
    for name in names {
        built = built + " " + name
    }
    return built + "\n"
}

function integrityText(report: borrow IntegrityReport) -> String {
    var text = ""
    text = appendNameList(text, "missing colors:", report.missingColors)
    text = appendNameList(text, "missing materials:", report.missingMaterials)
    text = appendNameList(text, "missing text styles:", report.missingTextStyles)
    text = appendNameList(text, "missing metrics:", report.missingMetrics)
    text = appendNameList(text, "missing glass:", report.missingGlass)
    text = appendNameList(text, "undeclared colors:", report.undeclaredColors)
    text = appendNameList(text, "undeclared materials:", report.undeclaredMaterials)
    text = appendNameList(text, "undeclared text styles:", report.undeclaredTextStyles)
    text = appendNameList(text, "undeclared metrics:", report.undeclaredMetrics)
    text = appendNameList(text, "undeclared glass:", report.undeclaredGlass)
    if text.count == 0 {
        return "catalog and name surface agree\n"
    }
    return text
}

// Every name this build declares, across every kind. For an editor's outline
// and for a catalog author checking coverage.
function allDeclaredNames() -> [String] {
    var names: [String] = []
    for name in allColorNames() {
        names.append(name)
    }
    for name in allMaterialNames() {
        names.append(name)
    }
    for name in allTextStyleNames() {
        names.append(name)
    }
    for name in allMetricNames() {
        names.append(name)
    }
    for name in allGlassNames() {
        names.append(name)
    }
    return names
}
