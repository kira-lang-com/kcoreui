// --- The content hierarchy -------------------------------------------------
//
// The kit's `Labels` collection, as iOS 26 draws it: where the kit and the
// system's own color catalog (CoreUI's `DesignLibrary-iOS.bundle`,
// `iOSRepositories/*Standard.car`) part, the catalog's value is the one set.
// The kit's dark secondary label is 0.7 opaque; the catalog's, and the
// device's, is 0.6.

function labelResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(
        sizedAdaptiveColor(
            ColorName.label,
            rgba255(0.0, 0.0, 0.0, 1.0),
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(0.0, 0.0, 0.0, 0.85),
            rgba255(255.0, 255.0, 255.0, 0.85)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.secondaryLabel,
            rgba255(60.0, 60.0, 67.0, 0.6),
            rgba255(235.0, 235.0, 245.0, 0.6),
            rgba255(0.0, 0.0, 0.0, 0.5),
            rgba255(255.0, 255.0, 255.0, 0.55)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.tertiaryLabel,
            rgba255(60.0, 60.0, 67.0, 0.3),
            rgba255(235.0, 235.0, 245.0, 0.3),
            rgba255(0.0, 0.0, 0.0, 0.26),
            rgba255(255.0, 255.0, 255.0, 0.25)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.quaternaryLabel,
            rgba255(60.0, 60.0, 67.0, 0.18),
            rgba255(235.0, 235.0, 245.0, 0.16),
            rgba255(0.0, 0.0, 0.0, 0.1),
            rgba255(255.0, 255.0, 255.0, 0.1)
        )
    )
    // A Mac sets a placeholder in the secondary ink, not the tertiary.
    records.append(
        sizedAdaptiveColor(
            ColorName.placeholderText,
            rgba255(60.0, 60.0, 67.0, 0.3),
            rgba255(235.0, 235.0, 245.0, 0.3),
            rgba255(0.0, 0.0, 0.0, 0.5),
            rgba255(255.0, 255.0, 255.0, 0.55)
        )
    )

    // Apple's hierarchical shape styles are the same ladder under shorter
    // names, so they are references rather than a second set of numbers.
    records.append(aliasColor(ColorName.primary, ColorName.label))
    records.append(aliasColor(ColorName.secondary, ColorName.secondaryLabel))
    records.append(aliasColor(ColorName.tertiary, ColorName.tertiaryLabel))
    records.append(aliasColor(ColorName.quaternary, ColorName.quaternaryLabel))
    records.append(
        sizedAdaptiveColor(
            ColorName.quinary,
            rgba255(60.0, 60.0, 67.0, 0.1),
            rgba255(235.0, 235.0, 245.0, 0.1),
            rgba255(0.0, 0.0, 0.0, 0.05),
            rgba255(255.0, 255.0, 255.0, 0.05)
        )
    )
    records.append(aliasColor(ColorName.foreground, ColorName.label))
    records.append(aliasColor(ColorName.placeholder, ColorName.placeholderText))
    return records
}

// --- Backgrounds, fills, separators ----------------------------------------
//
// The kit's `Backgrounds`, `Backgrounds (Grouped)`, `Fills` and `Separators`
// collections. The grouped ladder is not the plain one: its canvas is the gray
// a grouped table sits on, and its second rung is the white of the table's
// rows.

function surfaceResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    // On a Mac the plain canvas is the window's, as SwiftUI's background is
    // there: white in light and 30 gray in dark, measured on macOS 27.
    records.append(
        sizedAdaptiveColor(
            ColorName.systemBackground,
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(0.0, 0.0, 0.0, 1.0),
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(30.0, 30.0, 30.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.secondarySystemBackground,
            rgba255(242.0, 242.0, 247.0, 1.0),
            rgba255(28.0, 28.0, 30.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.tertiarySystemBackground,
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(44.0, 44.0, 46.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.windowBackground,
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(30.0, 30.0, 30.0, 1.0)
        )
    )
    records.append(aliasColor(ColorName.background, ColorName.systemBackground))

    records.append(
        adaptiveColor(
            ColorName.systemGroupedBackground,
            rgba255(242.0, 242.0, 247.0, 1.0),
            rgba255(0.0, 0.0, 0.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.secondarySystemGroupedBackground,
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(28.0, 28.0, 30.0, 1.0)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.tertiarySystemGroupedBackground,
            rgba255(242.0, 242.0, 247.0, 1.0),
            rgba255(44.0, 44.0, 46.0, 1.0)
        )
    )

    records.append(
        sizedAdaptiveColor(
            ColorName.systemFill,
            // The catalog's light fill is blued as the others are; the kit's
            // is a neutral gray.
            rgba255(120.0, 120.0, 128.0, 0.2),
            rgba255(120.0, 120.0, 128.0, 0.36),
            rgba255(0.0, 0.0, 0.0, 0.1),
            rgba255(255.0, 255.0, 255.0, 0.1)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.secondarySystemFill,
            rgba255(120.0, 120.0, 128.0, 0.16),
            rgba255(120.0, 120.0, 128.0, 0.32),
            rgba255(0.0, 0.0, 0.0, 0.08),
            rgba255(255.0, 255.0, 255.0, 0.08)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.tertiarySystemFill,
            rgba255(118.0, 118.0, 128.0, 0.12),
            rgba255(118.0, 118.0, 128.0, 0.24),
            rgba255(0.0, 0.0, 0.0, 0.05),
            rgba255(255.0, 255.0, 255.0, 0.05)
        )
    )
    records.append(
        sizedAdaptiveColor(
            ColorName.quaternarySystemFill,
            rgba255(116.0, 116.0, 128.0, 0.08),
            rgba255(118.0, 118.0, 128.0, 0.18),
            rgba255(0.0, 0.0, 0.0, 0.03),
            rgba255(255.0, 255.0, 255.0, 0.03)
        )
    )
    records.append(aliasColor(ColorName.fill, ColorName.systemFill))

    // A phone's separator is UIKit's under Solarium
    // (`__colorsByThemeKeySolariumseparatorColor`): 60 60 67 at 0.12 in light,
    // 84 84 88 at half in dark.
    records.append(
        sizedAdaptiveColor(
            ColorName.separator,
            rgba255(60.0, 60.0, 67.0, 0.12),
            rgba255(84.0, 84.0, 88.0, 0.5),
            rgba255(0.0, 0.0, 0.0, 0.1),
            rgba255(255.0, 255.0, 255.0, 0.1)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.opaqueSeparator,
            rgba255(198.0, 198.0, 200.0, 1.0),
            rgba255(56.0, 56.0, 58.0, 1.0)
        )
    )

    // UIKit's default indicator style: black at 35% in the light appearance,
    // white at half in the dark.
    records.append(
        adaptiveColor(
            ColorName.scrollIndicator,
            rgba255(0.0, 0.0, 0.0, 0.35),
            rgba255(255.0, 255.0, 255.0, 0.5)
        )
    )
    // The kit's hard scroll edge effect, at a top edge.
    records.append(
        adaptiveColor(
            ColorName.scrollEdgeFill,
            rgba255(255.0, 255.0, 255.0, 0.85),
            rgba255(31.0, 31.0, 31.0, 0.55)
        )
    )
    records.append(
        adaptiveColor(
            ColorName.scrollEdgeBorder,
            rgba255(0.0, 0.0, 0.0, 0.05),
            rgba255(255.0, 255.0, 255.0, 0.1)
        )
    )
    // The shadow the detail casts into the sidebar along its trailing edge.
    records.append(
        adaptiveColor(
            ColorName.sidebarShadow,
            rgba255(0.0, 0.0, 0.0, 0.05),
            rgba255(0.0, 0.0, 0.0, 0.2)
        )
    )
    // A workspace's panels: white on a light window, #18191B on a dark one.
    records.append(
        adaptiveColor(
            ColorName.workspacePanel,
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(24.0, 25.0, 27.0, 1.0)
        )
    )
    // The selected tab on it: a step up from the panel, #28292B on a dark one.
    return records
}

// --- Accents ---------------------------------------------------------------
//
// The kit tints with its blue. Its text selection is one wash in both
// appearances, drawn with a screen blend the catalog does not carry.

function accentResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(aliasColor(ColorName.tint, ColorName.systemBlue))
    records.append(
        adaptiveColor(
            ColorName.selection,
            rgba255(80.0, 156.0, 254.0, 0.2),
            rgba255(80.0, 156.0, 254.0, 0.2)
        )
    )
    records.append(aliasColor(ColorName.accentColor, ColorName.tint))
    records.append(aliasColor(ColorName.link, ColorName.systemBlue))
    return records
}

// --- What Apple has no word for --------------------------------------------
//
// These are in the catalog and not in `app/Names`, which is the arrangement the
// design intends. The declared surface is Apple's vocabulary and nothing else;
// a catalog may carry more, and a consumer that needs a concept Apple never
// named writes the name into a blob rather than asking permission from a file
// of constants.
//
// A toolkit needs all four of these and Apple spells none of them: ink that
// stays readable on a filled control, the three semantic intents a button asks
// for by meaning rather than by hue, and the rungs of a border ladder above the
// hairline `separator` already covers.

function toolkitResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(
        adaptiveColor("inverseLabel", rgba(0.98, 0.98, 1.0, 1.0), rgba(0.06, 0.07, 0.1, 1.0))
    )

    records.append(
        adaptiveColor("success", rgba(0.12, 0.58, 0.3, 1.0), rgba(0.34, 0.85, 0.52, 1.0))
    )
    records.append(
        adaptiveColor("warning", rgba(0.78, 0.48, 0.06, 1.0), rgba(0.98, 0.75, 0.25, 1.0))
    )
    // A destructive action is set in the system red, as Apple's kit sets a
    // destructive menu row: its title and its symbol both.
    records.append(
        adaptiveColor("danger", rgba255(255.0, 56.0, 60.0, 1.0), rgba255(255.0, 66.0, 69.0, 1.0))
    )

    records.append(
        adaptiveColor("standardBorder", rgba(0.08, 0.1, 0.16, 0.18), rgba(1.0, 1.0, 1.0, 0.18))
    )
    records.append(
        adaptiveColor("strongBorder", rgba(0.08, 0.1, 0.16, 0.32), rgba(1.0, 1.0, 1.0, 0.32))
    )
    records.append(
        adaptiveColor("focusRing", rgba(0.2, 0.45, 0.96, 0.86), rgba(0.43, 0.67, 1.0, 0.9))
    )

    // What a control's bezel is filled with: the kit's system fill on a phone,
    // and on a Mac the push button's and pop-up's, measured on macOS 27 -- two
    // layers of black at 0.047 and 0.03, white in the dark, which lay down
    // 0.076 between them.
    records.append(
        sizedAdaptiveColor(
            "controlBezel",
            rgba255(120.0, 120.0, 120.0, 0.2),
            rgba255(120.0, 120.0, 128.0, 0.36),
            rgba255(0.0, 0.0, 0.0, 0.076),
            rgba255(255.0, 255.0, 255.0, 0.076)
        )
    )

    // A Mac's text field: a bezel of white at 85% in the light and #161616 at
    // 85% in the dark, ringed by a hairline of black at 8% or white at 5%, as
    // SwiftUI draws one on macOS 27.
    records.append(
        adaptiveColor(
            "fieldBackground",
            rgba255(255.0, 255.0, 255.0, 0.85),
            rgba255(22.0, 22.0, 22.0, 0.85)
        )
    )
    records.append(
        adaptiveColor("fieldBorder", rgba255(0.0, 0.0, 0.0, 0.08), rgba255(255.0, 255.0, 255.0, 0.05))
    )

    // The selected row of a sidebar. The kit adds its tertiary vibrant fill to
    // the column (237 in light, 18 in dark, linear dodge): in light that
    // saturates every channel to white, and in dark it lifts the column by
    // 18/255, which is white at 7% over near-black.
    records.append(
        adaptiveColor(
            "sidebarSelection",
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(255.0, 255.0, 255.0, 0.07)
        )
    )

    // The kit's iPad tab bar: an unselected tab's title, #1A1A1A burned into
    // the glass in the light and #8A8A8A dodged into it in the dark, and the
    // capsule behind the selected one, #EDEDED burned and #121212 dodged. Each
    // is a material of one fill and its blend, as the vibrant labels are; laid
    // over the glass as colors they are a flat slab and a dull gray.
    records.append(vibrancyResource("tabLabel", 26.0 / 255.0, 138.0 / 255.0))
    records.append(vibrancyResource("tabSelection", 237.0 / 255.0, 18.0 / 255.0))

    // The kit's switch: green when on, a gray wash when off, and a white knob
    // either way. A Mac's switch and checkbox are off in its fill. The track under a slider's knob and under a progress bar's
    // fill are one lighter wash.
    records.append(
        adaptiveColor("switchOn", rgba255(52.0, 199.0, 89.0, 1.0), rgba255(52.0, 199.0, 89.0, 1.0))
    )
    records.append(
        sizedAdaptiveColor(
            "switchOff",
            rgba255(60.0, 60.0, 67.0, 0.3),
            rgba255(120.0, 120.0, 128.0, 0.32),
            rgba255(0.0, 0.0, 0.0, 0.1),
            rgba255(255.0, 255.0, 255.0, 0.1)
        )
    )
    records.append(
        adaptiveColor(
            "controlKnob",
            rgba255(255.0, 255.0, 255.0, 1.0),
            rgba255(255.0, 255.0, 255.0, 1.0)
        )
    )
    records.append(
        adaptiveColor("knobShadow", rgba255(0.0, 0.0, 0.0, 0.12), rgba255(0.0, 0.0, 0.0, 0.12))
    )
    records.append(
        adaptiveColor(
            "sliderTrack",
            rgba255(120.0, 120.0, 120.0, 0.2),
            rgba255(120.0, 120.0, 120.0, 0.2)
        )
    )
    // A held slider knob is clear glass washed with a little white.
    records.append(
        adaptiveColor(
            "sliderKnobGlass",
            rgba255(255.0, 255.0, 255.0, 0.09),
            rgba255(255.0, 255.0, 255.0, 0.09)
        )
    )
    // A progress bar's track: the kit's gray wash on a phone, and on a Mac
    // AppKit's, measured on macOS 27 -- black at 0.06 in light and white at
    // 0.08 in dark, edged in black at 0.07 and white at 0.04.
    records.append(
        sizedAdaptiveColor(
            "progressTrack",
            rgba255(120.0, 120.0, 120.0, 0.2),
            rgba255(120.0, 120.0, 120.0, 0.2),
            rgba255(0.0, 0.0, 0.0, 0.06),
            rgba255(255.0, 255.0, 255.0, 0.08)
        )
    )
    records.append(
        adaptiveColor(
            "progressTrackBorder",
            rgba255(0.0, 0.0, 0.0, 0.07),
            rgba255(255.0, 255.0, 255.0, 0.04)
        )
    )
    // The kit's menu shadow: black at a quarter in light, nearly half in dark,
    // where it has less to darken.
    records.append(
        adaptiveColor("menuShadow", rgba255(0.0, 0.0, 0.0, 0.25), rgba255(0.0, 0.0, 0.0, 0.45))
    )
    // A menu row held down: a gray pill over the glass, darker in light and
    // lighter in dark, faint enough that the glass still reads through it.
    records.append(
        adaptiveColor(
            "menuRowHighlight",
            rgba255(120.0, 120.0, 128.0, 0.12),
            rgba255(255.0, 255.0, 255.0, 0.08)
        )
    )
    return records
}

// Every color the default catalog defines.
function defaultColorResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    for record in paletteResources() { records.append(record) }
    for record in labelResources() { records.append(record) }
    for record in surfaceResources() { records.append(record) }
    for record in accentResources() { records.append(record) }
    for record in toolkitResources() { records.append(record) }
    return records
}
