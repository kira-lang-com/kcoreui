import Foundation

// The typed surface a consumer actually calls.
//
// Everything here answers a concrete value with every reference already
// followed, so a caller receives numbers and never a name. That is the boundary
// the design turns on: KiraUI names what something means, KCoreUI decides what
// it means here, and the renderer below receives blur radii and RGBA and has
// never heard the word "sidebar".
//
// Resolution is total. A name no catalog on the stack answers for produces the
// debug color rather than a failure a paint loop would have to thread through
// every call site. The floor catalog is required to be complete and the
// integrity check proves it, so a debug color on screen means the stack was
// assembled wrong, not that a lookup is allowed to fail.

// How many references a chain may follow before it is treated as a cycle.
//
// The catalog validator rejects cycles before a blob is written, so this is a
// backstop for a blob that arrived from somewhere else, not the mechanism.
function referenceDepthLimit() -> Int { return 16 }

// --- Colors ---------------------------------------------------------------
//
// A color is a stack of layers, so resolving one is: follow each layer's
// source, composite them bottom to top in linear light, and hand the result
// back in the gamut the environment reports.
//
// Everything between the catalog and that last step is linear-light Display P3.
// A caller sees neither: what it receives is an encoded color in its own
// gamut, which is what a renderer draws.

// One layer's color, in linear Display P3, with its references followed.
function resolveSourceLinear(stack: borrow CatalogStack, source: borrow ColorSource, environment: borrow UIEnvironment, depth: Int) -> Color {
    if !source.isReference {
        return decodeColor(source.color)
    }
    if depth >= referenceDepthLimit() {
        return decodeColor(debugColor())
    }
    let resolved = resolveResource(stack, source.reference, .Color, environment)
    if !resolved.found {
        return decodeColor(debugColor())
    }
    let read = decodeColorPayload(resolvedPayload(stack, resolved))
    if !read.ok {
        return decodeColor(debugColor())
    }
    return compositeLayers(stack, read.value, environment, depth + 1)
}

// A layer stack composited, in linear Display P3.
//
// Bottom to top, source-over. An empty stack is fully transparent, which is a
// color a catalog is entitled to hold: a token meaning "draw nothing here"
// says so with no layers rather than with an alpha nobody can see.
function compositeLayers(stack: borrow CatalogStack, value: borrow ColorValue, environment: borrow UIEnvironment, depth: Int) -> Color {
    var result = Color(r: 0.0, g: 0.0, b: 0.0, a: 0.0)
    for layer in value.layers {
        var source = resolveSourceLinear(stack, layer.source, environment, depth)
        source.a = source.a * layer.opacity
        result = compositeOver(source, result)
    }
    return result
}

// A color value composited and handed back in the environment's gamut.
function resolveColorValue(stack: borrow CatalogStack, value: borrow ColorValue, environment: borrow UIEnvironment, depth: Int) -> Color {
    let composited = compositeLayers(stack, value, environment, depth)
    return colorForGamut(encodeColorChannels(composited), environment.gamut)
}

// One layer source, resolved the way a gradient stop and a material tint need
// it: followed, encoded, and in the environment's gamut.
function resolveColorSource(stack: borrow CatalogStack, source: borrow ColorSource, environment: borrow UIEnvironment, depth: Int) -> Color {
    let linear = resolveSourceLinear(stack, source, environment, depth)
    return colorForGamut(encodeColorChannels(linear), environment.gamut)
}

// Whether a color resolved, alongside the color. For a debugger and for the
// integrity check; ordinary drawing code wants `resolveColor`.
struct ColorResolution {
    var color: Color = Color()
    var found: Bool = false
}

function resolveColorChecked(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ColorResolution {
    var resolution = ColorResolution()
    resolution.color = debugColor()
    let resolved = resolveResource(stack, name, .Color, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Color) {
        return resolution
    }
    let read = decodeColorPayload(resolvedPayload(stack, resolved))
    if !read.ok {
        return resolution
    }
    resolution.color = resolveColorValue(stack, read.value, environment, 0)
    resolution.found = true
    return resolution
}

// The color a semantic name means in this environment.
function resolveColor(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> Color {
    return resolveColorChecked(stack, name, environment).color
}

// --- Gradients -------------------------------------------------------------

struct ResolvedGradientStop {
    var position: Float = 0.0
    var color: Color = Color()
}

struct ResolvedGradient {
    var found: Bool = false
    var kind: GradientKind = .Linear
    var startX: Float = 0.0
    var startY: Float = 0.0
    var endX: Float = 0.0
    var endY: Float = 1.0
    var stops: [ResolvedGradientStop] = []
}

function resolveGradient(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedGradient {
    var gradient = ResolvedGradient()
    let resolved = resolveResource(stack, name, .Gradient, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Gradient) {
        return gradient
    }
    let read = decodeGradient(resolvedPayload(stack, resolved))
    if !read.ok {
        return gradient
    }
    gradient.found = true
    gradient.kind = read.value.kind
    gradient.startX = read.value.startX
    gradient.startY = read.value.startY
    gradient.endX = read.value.endX
    gradient.endY = read.value.endY
    for stop in read.value.stops {
        var resolvedStop = ResolvedGradientStop()
        resolvedStop.position = stop.position
        resolvedStop.color = resolveColorSource(stack, stop.color, environment, 0)
        gradient.stops.append(resolvedStop)
    }
    return gradient
}

// --- Materials -------------------------------------------------------------

// A layer with nothing left to look up. This is what a compositor is handed.
struct ResolvedMaterialLayer {
    var kind: MaterialLayerKind = .Fill
    var amount: Float = 0.0
    var color: Color = Color()
    var opacity: Float = 1.0
    var blend: BlendMode = .Normal
}

struct ResolvedMaterial {
    var found: Bool = false
    var layers: [ResolvedMaterialLayer] = []
}

function resolveMaterial(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedMaterial {
    var material = ResolvedMaterial()
    let resolved = resolveResource(stack, name, .Material, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Material) {
        return material
    }
    let read = decodeMaterial(resolvedPayload(stack, resolved))
    if !read.ok {
        return material
    }
    material.found = true
    for layer in read.value.layers {
        var resolvedLayer = ResolvedMaterialLayer()
        resolvedLayer.kind = layer.kind
        resolvedLayer.amount = layer.amount
        resolvedLayer.opacity = layer.opacity
        resolvedLayer.blend = layer.blend
        resolvedLayer.color = resolveColorSource(stack, layer.color, environment, 0)
        material.layers.append(resolvedLayer)
    }
    return material
}

// The blur radius a material asks for, or zero. A surface that needs one number
// rather than the whole recipe asks for it here instead of walking the layers.
function materialBlurRadius(material: borrow ResolvedMaterial) -> Float {
    for layer in material.layers {
        if layer.kind == .BackdropBlur {
            return layer.amount
        }
    }
    return 0.0
}

// --- Effects ---------------------------------------------------------------

struct ResolvedEffectOp {
    var kind: EffectOpKind = .Blur
    var radius: Float = 0.0
    var offsetX: Float = 0.0
    var offsetY: Float = 0.0
    var spread: Float = 0.0
    var amount: Float = 1.0
    var color: Color = Color()
}

struct ResolvedEffect {
    var found: Bool = false
    var ops: [ResolvedEffectOp] = []
}

function resolveEffect(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedEffect {
    var effect = ResolvedEffect()
    let resolved = resolveResource(stack, name, .Effect, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Effect) {
        return effect
    }
    let read = decodeEffect(resolvedPayload(stack, resolved))
    if !read.ok {
        return effect
    }
    effect.found = true
    for op in read.value.ops {
        var resolvedOp = ResolvedEffectOp()
        resolvedOp.kind = op.kind
        resolvedOp.radius = op.radius
        resolvedOp.offsetX = op.offsetX
        resolvedOp.offsetY = op.offsetY
        resolvedOp.spread = op.spread
        resolvedOp.amount = op.amount
        resolvedOp.color = resolveColorSource(stack, op.color, environment, 0)
        effect.ops.append(resolvedOp)
    }
    return effect
}

// --- Typography ------------------------------------------------------------

struct ResolvedTypography {
    var found: Bool = false
    var value: TypographyValue = TypographyValue()
}

function resolveTypography(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedTypography {
    var typography = ResolvedTypography()
    let resolved = resolveResource(stack, name, .Typography, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Typography) {
        return typography
    }
    let read = decodeTypography(resolvedPayload(stack, resolved))
    if !read.ok {
        return typography
    }
    typography.found = true
    typography.value = read.value
    return typography
}

// --- Metrics ---------------------------------------------------------------

struct ResolvedMetric {
    var found: Bool = false
    var points: Float = 0.0
}

function resolveMetric(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedMetric {
    var metric = ResolvedMetric()
    let resolved = resolveResource(stack, name, .Metric, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Metric) {
        return metric
    }
    let read = decodeMetric(resolvedPayload(stack, resolved))
    if !read.ok {
        return metric
    }
    metric.found = true
    metric.points = read.value.points
    return metric
}

// --- Glass -----------------------------------------------------------------

struct ResolvedGlass {
    var found: Bool = false
    var ramps: [GlassRamp] = []
}

function resolveGlass(stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> ResolvedGlass {
    var glass = ResolvedGlass()
    let resolved = resolveResource(stack, name, .Glass, environment)
    if !resolved.found || !resourceKindsEqual(resolved.kind, .Glass) {
        return glass
    }
    let read = decodeGlass(resolvedPayload(stack, resolved))
    if !read.ok {
        return glass
    }
    glass.found = true
    glass.ramps = read.value.ramps
    return glass
}

// Whether a recipe states an input at all. An input it leaves out is one the
// platform does not draw for this glass, which is different from one it draws
// at zero.
function glassStates(glass: borrow ResolvedGlass, input: GlassInput) -> Bool {
    let wanted = glassInputValue(input)
    for ramp in glass.ramps {
        if glassInputValue(ramp.input) == wanted {
            return true
        }
    }
    return false
}

// One input of a recipe on a surface whose shorter side is `extent`, or zero
// when the recipe does not state it.
function glassFigure(glass: borrow ResolvedGlass, input: GlassInput, extent: Float) -> Float {
    let wanted = glassInputValue(input)
    for ramp in glass.ramps {
        if glassInputValue(ramp.input) == wanted {
            return glassRampAt(ramp, extent)
        }
    }
    return 0.0
}
