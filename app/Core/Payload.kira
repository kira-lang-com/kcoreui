import Foundation

// Typed payloads for the kinds KCoreUI knows.
//
// A payload is bytes the container never inspects, so these encoders are a
// convenience for producers and these decoders a convenience for consumers.
// Neither is privileged: a producer may write its own bytes under its own kind
// and the catalog will carry, resolve and write them back correctly without
// this file being involved.
//
// Every payload opens with a one-byte version. A decoder that meets a version
// it does not know answers `ok: false` rather than reading the bytes as if it
// did.

function payloadVersion() -> Int { return 1 }

// --- Colour sources --------------------------------------------------------
//
// What one layer of a colour is made of: literal Display P3 channels, or the
// name of another resource. The reference is what makes a material's tint
// follow the colour it names — nothing is copied at author time, so a tint
// written against `separator` is still right in dark appearance and in high
// contrast, because the reference resolves against the same environment the
// material did.

function colorSourceLiteral() -> Int { return 1 }
function colorSourceReference() -> Int { return 2 }

struct ColorSource {
    var isReference: Bool = false
    var color: Color = Color()
    var reference: String = ""
}

// The colour a resolver answers with when a name is absent from every catalog
// on the stack, or when a reference chain does not terminate. Deliberately
// loud: the bottom catalog is required to be complete and an integrity test
// proves it, so seeing this on screen means the stack was built wrong.
function debugColor() -> Color {
    return Color(r: 1.0, g: 0.0, b: 1.0, a: 1.0)
}

function literalColor(color: borrow Color) -> ColorSource {
    var source = ColorSource()
    source.isReference = false
    source.color = color
    return source
}

function referenceColor(name: borrow String) -> ColorSource {
    var source = ColorSource()
    source.isReference = true
    source.reference = name
    return source
}

function appendColorSource(bytes: borrow mut [U8], source: borrow ColorSource) {
    if source.isReference {
        appendU8(bytes, colorSourceReference())
        appendU16(bytes, source.reference.count)
        appendStringBytes(bytes, source.reference)
    } else {
        appendU8(bytes, colorSourceLiteral())
        appendI32(bytes, fixedFromFloat(source.color.r))
        appendI32(bytes, fixedFromFloat(source.color.g))
        appendI32(bytes, fixedFromFloat(source.color.b))
        appendI32(bytes, fixedFromFloat(source.color.a))
    }
}

// A decoded source and where reading it ended. Kira has no tuples, so a reader
// that advances a cursor answers one of these.
struct ColorSourceRead {
    var value: ColorSource = ColorSource()
    var next: Int = 0
    var ok: Bool = false
}

function readColorSource(bytes: borrow [U8], offset: Int) -> ColorSourceRead {
    var read = ColorSourceRead()
    read.next = offset
    if offset < 0 || offset >= bytes.count {
        return read
    }
    let tag = readU8(bytes, offset)
    if tag == colorSourceLiteral() {
        if offset + 17 > bytes.count {
            return read
        }
        var color = Color()
        color.r = floatFromFixed(readI32(bytes, offset + 1))
        color.g = floatFromFixed(readI32(bytes, offset + 5))
        color.b = floatFromFixed(readI32(bytes, offset + 9))
        color.a = floatFromFixed(readI32(bytes, offset + 13))
        read.value = literalColor(color)
        read.next = offset + 17
        read.ok = true
        return read
    }
    if tag == colorSourceReference() {
        let length = readU16(bytes, offset + 1)
        if offset + 3 + length > bytes.count {
            return read
        }
        let slice = sliceBytes(bytes, offset + 3, length)
        read.value = referenceColor(stringFromBytes(slice))
        read.next = offset + 3 + length
        read.ok = true
        return read
    }
    return read
}

// --- Colour resources ------------------------------------------------------
//
// A colour is a **stack of layers**, bottom to top, each with its own alpha.
//
// That is what a system colour actually is. A separator is ink at a tenth of an
// opacity over whatever it sits on; a fill is a wash over a surface; a disabled
// control is its own colour under a scrim. Flattening those into one RGBA at
// author time throws away the structure and, worse, bakes in the backdrop —
// which is exactly what a resource system must not do, because the backdrop
// changes with the appearance.
//
// Layers composite source-over in linear light, in Display P3. A single-layer
// colour is the common case and costs one layer.

struct ColorLayer {
    var source: ColorSource = ColorSource()
    // Multiplies the source's own alpha. A layer written as "this ink at 10%"
    // says so here rather than by editing the ink's alpha, so the ink stays the
    // named colour it is.
    var opacity: Float = 1.0
}

struct ColorValue {
    var layers: [ColorLayer] = []
}

function colorLayer(source: borrow ColorSource, opacity: Float) -> ColorLayer {
    var layer = ColorLayer()
    layer.source = source
    layer.opacity = opacity
    return layer
}

// The one-layer case, which is most of them.
function singleLayer(color: borrow Color) -> ColorValue {
    var value = ColorValue()
    value.layers.append(colorLayer(literalColor(color), 1.0))
    return value
}

// One name meaning another, at full opacity.
function aliasLayer(name: borrow String) -> ColorValue {
    var value = ColorValue()
    value.layers.append(colorLayer(referenceColor(name), 1.0))
    return value
}

function encodeColorValue(value: borrow ColorValue) -> [U8] {
    var bytes: [U8] = []
    appendU8(bytes, payloadVersion())
    appendU16(bytes, value.layers.count)
    for layer in value.layers {
        appendI32(bytes, fixedFromFloat(layer.opacity))
        appendColorSource(bytes, layer.source)
    }
    return bytes
}

// The common spellings, so a producer authoring one flat colour writes one call.
function encodeColor(color: borrow Color) -> [U8] {
    return encodeColorValue(singleLayer(color))
}

function encodeColorAlias(name: borrow String) -> [U8] {
    return encodeColorValue(aliasLayer(name))
}

struct ColorValueRead {
    var value: ColorValue = ColorValue()
    var ok: Bool = false
}

function decodeColorPayload(bytes: borrow [U8]) -> ColorValueRead {
    var read = ColorValueRead()
    if bytes.count < 3 || readU8(bytes, 0) != payloadVersion() {
        return read
    }
    let layerCount = readU16(bytes, 1)
    var value = ColorValue()
    var cursor = 3
    var index = 0
    while index < layerCount {
        if cursor + 4 > bytes.count {
            return read
        }
        var layer = ColorLayer()
        layer.opacity = floatFromFixed(readI32(bytes, cursor))
        let sourceRead = readColorSource(bytes, cursor + 4)
        if !sourceRead.ok {
            return read
        }
        layer.source = sourceRead.value
        value.layers.append(layer)
        cursor = sourceRead.next
        index = index + 1
    }
    read.value = value
    read.ok = true
    return read
}

// --- Gradients -------------------------------------------------------------

enum GradientKind {
    Linear
    Radial
    Angular
}

function gradientKindValue(kind: borrow GradientKind) -> Int {
    match kind {
        Linear -> return 1
        Radial -> return 2
        Angular -> return 3
    }
}

function gradientKindFromValue(value: Int) -> GradientKind {
    if value == 2 { return .Radial }
    if value == 3 { return .Angular }
    return .Linear
}

// One stop, at a position along the gradient's own 0-to-1 axis.
struct GradientStop {
    var position: Float = 0.0
    var color: ColorSource = ColorSource()
}

// Start and end are in the resource's unit space: a linear gradient runs from
// start to end, a radial one is centred on start with end fixing its radius,
// and an angular one sweeps around start beginning at the angle to end.
struct GradientValue {
    var kind: GradientKind = .Linear
    var startX: Float = 0.0
    var startY: Float = 0.0
    var endX: Float = 0.0
    var endY: Float = 1.0
    var stops: [GradientStop] = []
}

function encodeGradient(gradient: borrow GradientValue) -> [U8] {
    var bytes: [U8] = []
    appendU8(bytes, payloadVersion())
    appendU8(bytes, gradientKindValue(gradient.kind))
    appendI32(bytes, fixedFromFloat(gradient.startX))
    appendI32(bytes, fixedFromFloat(gradient.startY))
    appendI32(bytes, fixedFromFloat(gradient.endX))
    appendI32(bytes, fixedFromFloat(gradient.endY))
    appendU16(bytes, gradient.stops.count)
    for stop in gradient.stops {
        appendI32(bytes, fixedFromFloat(stop.position))
        appendColorSource(bytes, stop.color)
    }
    return bytes
}

struct GradientRead {
    var value: GradientValue = GradientValue()
    var ok: Bool = false
}

function decodeGradient(bytes: borrow [U8]) -> GradientRead {
    var read = GradientRead()
    if bytes.count < 20 || readU8(bytes, 0) != payloadVersion() {
        return read
    }
    var gradient = GradientValue()
    gradient.kind = gradientKindFromValue(readU8(bytes, 1))
    gradient.startX = floatFromFixed(readI32(bytes, 2))
    gradient.startY = floatFromFixed(readI32(bytes, 6))
    gradient.endX = floatFromFixed(readI32(bytes, 10))
    gradient.endY = floatFromFixed(readI32(bytes, 14))
    let stopCount = readU16(bytes, 18)
    var cursor = 20
    var index = 0
    while index < stopCount {
        if cursor + 4 > bytes.count {
            return read
        }
        var stop = GradientStop()
        stop.position = floatFromFixed(readI32(bytes, cursor))
        let sourceRead = readColorSource(bytes, cursor + 4)
        if !sourceRead.ok {
            return read
        }
        stop.color = sourceRead.value
        gradient.stops.append(stop)
        cursor = sourceRead.next
        index = index + 1
    }
    read.value = gradient
    read.ok = true
    return read
}
