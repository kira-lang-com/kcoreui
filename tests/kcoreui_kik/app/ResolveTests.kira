import Foundation
import KCoreUI

// References, recipes and the typed surface.
//
// The reference is what makes the design pay: a material's tint names a color
// instead of copying one, so the recipe is authored once and is still correct
// in an appearance nobody had in mind when it was written. These cases prove
// that, and prove a reference chain cannot run away.

namespace TestColor {
    let ink: RGBAColor = color(0.1, 0.1, 0.1, 1.0)
    let paper: RGBAColor = color(0.95, 0.95, 0.95, 1.0)
}

function referenceRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", TestColor.ink, TestColor.paper))
    record.resources.append(alias("foreground", "label"))
    record.resources.append(alias("primary", "foreground"))
    return record
}

// --- References ------------------------------------------------------------

construct KcuAnAliasResolvesToWhatItNames() extends Test {
    test {
        let stack = stackOf(referenceRecord())
        return colorsEqual(stack.resolveColor("foreground", light()), TestColor.ink)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The reference is followed against the *caller's* environment, which is why an
// alias needs no renditions of its own to stay correct in dark appearance.
construct KcuAnAliasFollowsTheEnvironmentRatherThanACopy() extends Test {
    test {
        let stack = stackOf(referenceRecord())
        return colorsEqual(stack.resolveColor("foreground", dark()), TestColor.paper)
            && colorsEqual(stack.resolveColor("foreground", light()), TestColor.ink)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuAChainOfAliasesResolves() extends Test {
    test {
        let stack = stackOf(referenceRecord())
        return colorsEqual(stack.resolveColor("primary", dark()), TestColor.paper)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// An override of the target moves everything pointing at it, with no second
// edit anywhere.
construct KcuOverridingATargetMovesEveryAliasPointingAtIt() extends Test {
    test {
        var overlay = CatalogRecord()
        overlay.resources.append(flat("label", color(1.0, 0.0, 0.0, 1.0)))
        let stack = (stackOf(referenceRecord())).overlaid(catalogOf(overlay))
        return colorsEqual(stack.resolveColor("primary", light()), color(1.0, 0.0, 0.0, 1.0))
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A reference to a name nothing defines is the debug color rather than a trap
// or a silent black.
construct KcuADanglingReferenceIsTheDebugColor() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("foreground", "nothingDefinesThis"))
        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("foreground", light()), ResolverFallback.color)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The validator rejects cycles before a blob is written; this proves the
// runtime backstop for a blob that arrived from somewhere else stops rather
// than recurring forever.
construct KcuAReferenceCycleStopsAtTheDepthLimit() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("a", "b"))
        record.resources.append(alias("b", "a"))
        let stack = stackOf(record)
        return colorsEqual(stack.resolveColor("a", light()), ResolverFallback.color)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Materials -------------------------------------------------------------

function materialRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("systemBackground", TestColor.paper, TestColor.ink))
    record.resources.append(flat("separator", color(0.0, 0.0, 0.0, 0.1)))

    var translucent = MaterialValue()
    translucent.layers.append(backdropBlurLayer(28.0))
    translucent.layers.append(saturationLayer(1.4))
    translucent.layers.append(tintLayer(referenceColor("systemBackground"), 0.68, .Normal))
    translucent.layers.append(borderLayer(referenceColor("separator"), 1.0))

    var opaque = MaterialValue()
    opaque.layers.append(fillLayer(referenceColor("systemBackground"), 1.0, .Normal))

    var resource = ResourceRecord()
    resource.name = "regular"
    resource.kind = .Material
    var open = RenditionRecord()
    open.payload = translucent.encoded()
    resource.renditions.append(open)
    var reduced = RenditionRecord()
    reduced.constraints.append(TraitIdentifier.ReduceTransparency.constrain(flagValue(true)))
    reduced.payload = opaque.encoded()
    resource.renditions.append(reduced)
    record.resources.append(resource)
    return record
}

construct KcuAMaterialResolvesItsWholeRecipe() extends Test {
    test {
        let resolved = (stackOf(materialRecord())).resolveMaterial("regular", light())
        return resolved.found
            && resolved.layers.count == 4
            && resolved.blurRadius() == 28.0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The recipe is one authored thing; only what its references resolve to moves.
construct KcuAMaterialTintFollowsTheAppearanceWithoutASecondRecipe() extends Test {
    test {
        let stack = stackOf(materialRecord())
        let light = stack.resolveMaterial("regular", light())
        let dark = stack.resolveMaterial("regular", dark())
        if light.layers.count != dark.layers.count {
            return false
        }
        return colorsEqual(light.layers[2].color, TestColor.paper)
            && colorsEqual(dark.layers[2].color, TestColor.ink)
            && light.layers[0].amount == dark.layers[0].amount
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Reduced transparency is a different recipe, not the same one turned down,
// and the catalog is where that is decided rather than in a compositor.
construct KcuReducedTransparencySelectsTheOpaqueRecipe() extends Test {
    test {
        let stack = stackOf(materialRecord())
        let reduced = stack.resolveMaterial("regular", reducedTransparency())
        return reduced.found
            && reduced.layers.count == 1
            && reduced.blurRadius() == 0.0
            && colorsEqual(reduced.layers[0].color, TestColor.ink)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuAskingForAMaterialByTheWrongKindFindsNothing() extends Test {
    test { return (stackOf(materialRecord())).resolveMaterial("separator", light()).found }
    expect {
        let e: Result<Any, TestFailure> = .Ok(false)
        return e
    }
}

// --- Gradients -------------------------------------------------------------

construct KcuAGradientResolvesItsStops() extends Test {
    test {
        var gradient = GradientValue()
        gradient.kind = .Radial
        gradient.startX = 0.5
        gradient.startY = 0.5
        gradient.endX = 1.0
        gradient.endY = 0.5
        gradient.stops.append(
            GradientStop(position: 0.0, color: referenceColor("systemBackground"))
        )
        gradient.stops.append(
            GradientStop(position: 1.0, color: literalColor(color(0.0, 0.0, 0.0, 0.0)))
        )

        var resource = ResourceRecord()
        resource.name = "windowWash"
        resource.kind = .Gradient
        var rendition = RenditionRecord()
        rendition.payload = gradient.encoded()
        resource.renditions.append(rendition)

        var record = materialRecord()
        record.resources.append(resource)

        let resolved = (stackOf(record)).resolveGradient("windowWash", dark())
        return resolved.found
            && resolved.kind == .Radial
            && resolved.stops.count == 2
            && resolved.startX == 0.5
            && colorsEqual(resolved.stops[0].color, TestColor.ink)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Effects ---------------------------------------------------------------

construct KcuAnEffectResolvesItsOps() extends Test {
    test {
        var effect = EffectValue()
        effect.ops.append(shadowOp(referenceColor("separator"), 0.0, 2.0, 8.0, 0.0))
        effect.ops.append(opacityOp(0.8))

        var resource = ResourceRecord()
        resource.name = "cardShadow"
        resource.kind = .Effect
        var rendition = RenditionRecord()
        rendition.payload = effect.encoded()
        resource.renditions.append(rendition)

        var record = materialRecord()
        record.resources.append(resource)

        let resolved = (stackOf(record)).resolveEffect("cardShadow", light())
        return resolved.found
            && resolved.ops.count == 2
            && resolved.ops[0].kind == .Shadow
            && resolved.ops[0].offsetY == 2.0
            && resolved.ops[0].radius == 8.0
            && near(resolved.ops[1].amount, 0.8)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// --- Typography ------------------------------------------------------------

construct KcuATextStyleResolvesItsMetrics() extends Test {
    test {
        var value = TypographyValue()
        value.family = "Kira Sans"
        value.size = 15.0
        value.weight = 400
        value.lineHeight = 21.0
        value.tracking = -0.3

        var resource = ResourceRecord()
        resource.name = "body"
        resource.kind = .Typography
        var rendition = RenditionRecord()
        rendition.payload = value.encoded()
        resource.renditions.append(rendition)

        var record = CatalogRecord()
        record.resources.append(resource)

        let resolved = (stackOf(record)).resolveTypography("body", light())
        return resolved.found
            && resolved.value.size == 15.0
            && resolved.value.weight == 400
            && resolved.value.lineHeight == 21.0
            && near(resolved.value.tracking, -0.3)
            && compareStrings(resolved.value.family, "Kira Sans") == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
