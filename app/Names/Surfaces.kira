import Foundation

// Apple's material and text-style vocabularies, in SwiftUI's spelling.
//
// The material ladder is `ultraThin` through `ultraThick` plus `bar`. Two
// entries are worth naming because existing Kira code disagrees with them:
// KiraUIFoundation spells the ladder `Ultrathin, Thin, Regular, Thick, Chrome`,
// which is `bar` under another name and is missing `ultraThick` entirely. This
// file is the spelling; a catalog is what fills it in.
//
// The text styles are Apple's `Font.TextStyle` set. Apple names no gradients
// and no effects semantically, so this build declares none: inventing a name
// Apple does not have would be inventing surface, and a producer that needs one
// writes it into a blob without asking permission from this file.

// --- Materials -------------------------------------------------------------

public function materialUltraThin() -> String { return "ultraThin" }
public function materialThin() -> String { return "thin" }
public function materialRegular() -> String { return "regular" }
public function materialThick() -> String { return "thick" }
public function materialUltraThick() -> String { return "ultraThick" }
public function materialBar() -> String { return "bar" }

// --- Vibrancy --------------------------------------------------------------
//
// What content set INTO glass is inked with: UIKit's vibrancy effect styles,
// each a color together with the way it composites, which is what makes it
// vibrant rather than gray. A material because a material is exactly that — a
// recipe the compositor applies, color and blend at once.

public function materialVibrantLabel() -> String { return "vibrantLabel" }
public function materialVibrantSecondaryLabel() -> String { return "vibrantSecondaryLabel" }
public function materialVibrantTertiaryLabel() -> String { return "vibrantTertiaryLabel" }
public function materialVibrantQuaternaryLabel() -> String { return "vibrantQuaternaryLabel" }

public function allMaterialNames() -> [String] {
    var names: [String] = []
    names.append(materialUltraThin())
    names.append(materialThin())
    names.append(materialRegular())
    names.append(materialThick())
    names.append(materialUltraThick())
    names.append(materialBar())
    names.append(materialVibrantLabel())
    names.append(materialVibrantSecondaryLabel())
    names.append(materialVibrantTertiaryLabel())
    names.append(materialVibrantQuaternaryLabel())
    return names
}

// --- Text styles -----------------------------------------------------------

public function textLargeTitle() -> String { return "largeTitle" }
public function textTitle() -> String { return "title" }
public function textTitle2() -> String { return "title2" }
public function textTitle3() -> String { return "title3" }
public function textHeadline() -> String { return "headline" }
public function textSubheadline() -> String { return "subheadline" }
public function textBody() -> String { return "body" }
public function textCallout() -> String { return "callout" }
public function textFootnote() -> String { return "footnote" }
public function textCaption() -> String { return "caption" }
public function textCaption2() -> String { return "caption2" }

public function allTextStyleNames() -> [String] {
    var names: [String] = []
    names.append(textLargeTitle())
    names.append(textTitle())
    names.append(textTitle2())
    names.append(textTitle3())
    names.append(textHeadline())
    names.append(textSubheadline())
    names.append(textBody())
    names.append(textCallout())
    names.append(textFootnote())
    names.append(textCaption())
    names.append(textCaption2())
    return names
}
