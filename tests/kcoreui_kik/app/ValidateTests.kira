import Foundation
import KCoreUI

// What a producer is stopped from writing.
//
// The parser refuses a malformed container; the validator refuses a malformed
// catalog. Both matter, and they catch different things: a cycle is perfectly
// well-formed bytes describing a graph no resolver can finish walking.

function kcuIssueCount(record: borrow CatalogRecord, kind: borrow ValidationKind) -> Int {
    var count = 0
    for entry in validateRecord(record) {
        if entry.kind == kind {
            count = count + 1
        }
    }
    return count
}

construct KcuACleanRecordHasNoIssues() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuAdaptive("label", kcuColor(0.0, 0.0, 0.0, 1.0), kcuColor(1.0, 1.0, 1.0, 1.0)))
        record.resources.append(kcuAlias("foreground", "label"))
        return validateRecord(record).count
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0); return e }
}

construct KcuADanglingReferenceIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuAlias("foreground", "nothingDefinesThis"))
        return kcuIssueCount(record, ValidationKind.MissingReference)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

// The check that keeps a cycle out of a shipped blob rather than relying on the
// runtime depth limit to survive one.
construct KcuATwoStepCycleIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuAlias("a", "b"))
        record.resources.append(kcuAlias("b", "a"))
        return kcuIssueCount(record, ValidationKind.ReferenceCycle)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(2); return e }
}

construct KcuASelfReferenceIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuAlias("a", "a"))
        return kcuIssueCount(record, ValidationKind.ReferenceCycle)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

construct KcuALongerCycleIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuAlias("a", "b"))
        record.resources.append(kcuAlias("b", "c"))
        record.resources.append(kcuAlias("c", "a"))
        return kcuIssueCount(record, ValidationKind.ReferenceCycle)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(3); return e }
}

// A chain that never closes is not a cycle, however deep it goes.
construct KcuADeepChainIsNotACycle() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuFlat("root", kcuColor(0.0, 0.0, 0.0, 1.0)))
        record.resources.append(kcuAlias("a", "root"))
        record.resources.append(kcuAlias("b", "a"))
        record.resources.append(kcuAlias("c", "b"))
        record.resources.append(kcuAlias("d", "c"))
        return validateRecord(record).count
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0); return e }
}

// A material's tint reference participates in the graph exactly as a colour
// alias does, so a cycle through a recipe is caught too.
construct KcuACycleThroughAMaterialIsReported() extends Test {
    test {
        var recipe = MaterialValue()
        recipe.layers.append(tintLayer(referenceColor("wash"), 0.5, blendNormal()))
        var material = ResourceRecord()
        material.name = "wash"
        material.kind = kindColor()
        var rendition = RenditionRecord()
        rendition.payload = encodeColorAlias("wash")
        material.renditions.append(rendition)

        var record = CatalogRecord()
        record.resources.append(material)
        return kcuIssueCount(record, ValidationKind.ReferenceCycle)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

construct KcuADuplicateNameOfTheSameKindIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuFlat("label", kcuColor(0.0, 0.0, 0.0, 1.0)))
        record.resources.append(kcuFlat("label", kcuColor(1.0, 1.0, 1.0, 1.0)))
        return kcuIssueCount(record, ValidationKind.DuplicateName)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

// The same name under two kinds is two resources, not a duplicate.
construct KcuTheSameNameUnderTwoKindsIsNotADuplicate() extends Test {
    test {
        var material = ResourceRecord()
        material.name = "regular"
        material.kind = kindMaterial()
        var recipe = MaterialValue()
        recipe.layers.append(backdropBlurLayer(28.0))
        var rendition = RenditionRecord()
        rendition.payload = encodeMaterial(recipe)
        material.renditions.append(rendition)

        var record = CatalogRecord()
        record.resources.append(kcuFlat("regular", kcuColor(0.5, 0.5, 0.5, 1.0)))
        record.resources.append(material)
        return validateRecord(record).count
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0); return e }
}

construct KcuAResourceWithNoRenditionsIsReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = kindColor()
        var record = CatalogRecord()
        record.resources.append(resource)
        return kcuIssueCount(record, ValidationKind.NoRenditions)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

construct KcuAReservedTraitValueIsReportedBeforeWriting() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = kindColor()
        var rendition = RenditionRecord()
        rendition.constraints.append(constrain(traitContrast(), 0))
        rendition.payload = kcuAuthored(kcuColor(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(rendition)
        var record = CatalogRecord()
        record.resources.append(resource)
        return kcuIssueCount(record, ValidationKind.ReservedTraitValue)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

construct KcuTwoRenditionsPinningTheSameTraitsAreReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = kindColor()
        var first = RenditionRecord()
        first.constraints.append(whenAppearance(.Dark))
        first.payload = kcuAuthored(kcuColor(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(first)
        var second = RenditionRecord()
        second.constraints.append(whenAppearance(.Dark))
        second.payload = kcuAuthored(kcuColor(1.0, 1.0, 1.0, 1.0))
        resource.renditions.append(second)
        var record = CatalogRecord()
        record.resources.append(resource)
        return kcuIssueCount(record, ValidationKind.DuplicateRendition)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

// A payload that does not decode for the kind it is filed under is caught at
// authoring time rather than becoming a debug colour on screen.
construct KcuAPayloadThatDoesNotMatchItsKindIsReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = kindColor()
        var rendition = RenditionRecord()
        var payload: [U8] = []
        appendU8(payload, 99)
        appendU8(payload, 1)
        rendition.payload = payload
        resource.renditions.append(rendition)
        var record = CatalogRecord()
        record.resources.append(resource)
        return kcuIssueCount(record, ValidationKind.UndecodablePayload)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

// A kind this build has no decoder for is not an error. The container is
// agnostic about payload, and the validator has to agree with it.
construct KcuAnUndecodableKindIsNotAValidationFailure() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(kcuOpaqueResource("somethingElse"))
        return validateRecord(record).count
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0); return e }
}
