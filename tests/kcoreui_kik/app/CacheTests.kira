import Foundation
import KCoreUI

// The cache must be invisible.
//
// Every case here asks the same question twice: does the cached answer equal
// the uncached one. A cache that is ever right about anything the resolver is
// not is a cache that paints a stale color after an appearance change, which
// is the exact bug the environment-in-the-key design exists to prevent.

function cacheRecord() -> CatalogRecord {
    var record = CatalogRecord()
    record.resources.append(adaptive("label", color(0.0, 0.0, 0.0, 1.0), color(1.0, 1.0, 1.0, 1.0)))
    record.resources.append(
        adaptive("tint", color(0.25, 0.5, 1.0, 1.0), color(0.5, 0.75, 1.0, 1.0))
    )
    record.resources.append(alias("accentColor", "tint"))
    return record
}

construct KcuACachedColorEqualsTheUncachedOne() extends Test {
    test {
        let stack = stackOf(cacheRecord())
        var cache = makeDefaultCache()
        let direct = stack.resolveColor("label", light())
        let cached = cache.color(stack, "label", light())
        let again = cache.color(stack, "label", light())
        return colorsEqual(direct, cached) && colorsEqual(direct, again)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The environment is part of the key, so nothing has to be invalidated when the
// appearance changes and a value cached under the old one is still there when
// it comes back.
construct KcuTheEnvironmentIsPartOfTheKey() extends Test {
    test {
        let stack = stackOf(cacheRecord())
        var cache = makeDefaultCache()
        let light = cache.color(stack, "label", light())
        let dark = cache.color(stack, "label", dark())
        let lightAgain = cache.color(stack, "label", light())
        return colorsEqual(light, color(0.0, 0.0, 0.0, 1.0))
            && colorsEqual(dark, color(1.0, 1.0, 1.0, 1.0))
            && colorsEqual(lightAgain, light)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuARepeatedLookupIsAHit() extends Test {
    test {
        let stack = stackOf(cacheRecord())
        var cache = makeDefaultCache()
        let _ = cache.color(stack, "label", light())
        let missesAfterFirst = cache.misses
        for index in 0..50 {
            let _ = cache.color(stack, "label", light())
        }
        return cache.misses == missesAfterFirst && cache.hits >= 50 && cache.hitRate() > 90
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Two kinds under one name must not share a slot.
construct KcuTheKindIsPartOfTheKey() extends Test {
    test {
        var record = cacheRecord()
        var material = ResourceRecord()
        material.name = "label"
        material.kind = .Material
        var recipe = MaterialValue()
        recipe.layers.append(backdropBlurLayer(12.0))
        var rendition = RenditionRecord()
        rendition.payload = recipe.encoded()
        material.renditions.append(rendition)
        record.resources.append(material)

        let stack = stackOf(record)
        var cache = makeDefaultCache()
        let asColor = cache.color(stack, "label", light())
        let asMaterial = cache.resolve(stack, "label", .Material, light())
        return colorsEqual(asColor, color(0.0, 0.0, 0.0, 1.0))
            && asMaterial.found
            && asMaterial.kind.equals(.Material)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Pushing a catalog can change what any name means, so the cache is dropped.
construct KcuPushingACatalogDropsTheCache() extends Test {
    test {
        var resources = makeResources(catalogOf(cacheRecord()), light())
        let before = resources.color("label")

        var overlay = CatalogRecord()
        overlay.resources.append(flat("label", color(1.0, 0.0, 0.0, 1.0)))
        resources.pushCatalog(catalogOf(overlay))
        let after = resources.color("label")

        return colorsEqual(before, color(0.0, 0.0, 0.0, 1.0))
            && colorsEqual(after, color(1.0, 0.0, 0.0, 1.0))
            && resources.cache.hits == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// An appearance change needs no invalidation at all, which is the whole reason
// a view can hold a semantic name forever.
construct KcuChangingTheAppearanceNeedsNoInvalidation() extends Test {
    test {
        var resources = makeResources(catalogOf(cacheRecord()), light())
        let light = resources.color("accentColor")
        resources.setAppearance(.Dark)
        let dark = resources.color("accentColor")
        resources.setAppearance(.Light)
        let lightAgain = resources.color("accentColor")
        return colorsEqual(light, color(0.25, 0.5, 1.0, 1.0))
            && colorsEqual(dark, color(0.5, 0.75, 1.0, 1.0))
            && colorsEqual(lightAgain, light)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// A cache smaller than the working set still answers correctly; it only stops
// answering quickly.
construct KcuASmallCacheStaysCorrectUnderEviction() extends Test {
    test {
        let stack = stackOf(cacheRecord())
        var cache = makeResolutionCache(16)
        for index in 0..200 {
            let value = cache.color(stack, "tint", dark())
            if !colorsEqual(value, color(0.5, 0.75, 1.0, 1.0)) {
                return false
            }
            let other = cache.color(stack, "label", light())
            if !colorsEqual(other, color(0.0, 0.0, 0.0, 1.0)) {
                return false
            }
        }
        return true
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

construct KcuClearingTheCacheResetsItsCounters() extends Test {
    test {
        let stack = stackOf(cacheRecord())
        var cache = makeDefaultCache()
        let _ = cache.color(stack, "label", light())
        let _ = cache.color(stack, "label", light())
        cache.clear()
        return cache.hits == 0 && cache.misses == 0 && cache.hitRate() == 0
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
