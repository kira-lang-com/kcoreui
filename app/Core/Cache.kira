import Foundation

// The two-level resolution cache.
//
// Every component reads its colours and materials from a catalog, so a
// resolution happens once per drawn value per frame rather than once per theme
// change. Without a cache that is a binary search plus an eligibility walk plus
// a payload decode, per value, per frame.
//
// Level one maps a name and an environment to the rendition that won. Level two
// keeps the decoded colour beside it, because a colour is the value a paint
// pass asks for most and decoding one is four fixed-point conversions and a
// possible reference chase.
//
// The key includes the environment, so nothing has to be invalidated when the
// appearance changes: the new environment simply misses and fills different
// slots. `clearCache` exists for the one case that does invalidate, which is
// the catalog stack itself being rebuilt.

struct CacheEntry {
    var used: Bool = false
    var hash: Int = 0
    var name: String = ""
    var kind: Int = 0
    var environmentKey: Int = 0
    var customKey: Int = 0
    var resolved: ResolvedRendition = ResolvedRendition()
    var color: Color = Color()
    var colorReady: Bool = false
}

struct ResolutionCache {
    var entries: [CacheEntry] = []
    var mask: Int = 0
    var hits: Int = 0
    var misses: Int = 0
    var evictions: Int = 0
}

// How far a lookup probes before it evicts rather than growing. A short bound
// keeps the worst case flat; the table is sized so it is rarely reached.
function cacheProbeLimit() -> Int { return 8 }

function defaultCacheCapacity() -> Int { return 1024 }

// A cache with `capacity` slots, rounded up to a power of two so the index is a
// mask rather than a remainder.
function makeResolutionCache(capacity: Int) -> ResolutionCache {
    var size = 16
    while size < capacity {
        size = size * 2
    }
    var cache = ResolutionCache()
    var index = 0
    while index < size {
        cache.entries.append(CacheEntry())
        index = index + 1
    }
    cache.mask = size - 1
    return cache
}

function makeDefaultCache() -> ResolutionCache {
    return makeResolutionCache(defaultCacheCapacity())
}

// Drop everything. Call when the catalog stack changes; an environment change
// needs nothing, because the environment is part of the key.
function clearCache(cache: borrow mut ResolutionCache) {
    for index in 0..cache.entries.count {
        cache.entries[index] = CacheEntry()
    }
    cache.hits = 0
    cache.misses = 0
    cache.evictions = 0
}

// FNV-1a over the name's bytes, folded with the environment words at probe time.
function nameHash(name: borrow String) -> Int {
    var hash = 2166136261
    for index in 0..name.count {
        hash = hash ^ (name.charAt(index) & 255)
        hash = hash * 16777619
    }
    return hash & 4611686018427387903
}

function probeStart(cache: borrow ResolutionCache, hash: Int, environmentKey: Int, customKey: Int) -> Int {
    var mixed = hash ^ (environmentKey * 2654435761)
    mixed = mixed ^ (customKey * 40503)
    mixed = mixed ^ (mixed >> 21)
    return mixed & cache.mask
}

function entryMatches(entry: borrow CacheEntry, hash: Int, name: borrow String, kind: Int, environmentKey: Int, customKey: Int) -> Bool {
    if !entry.used || entry.hash != hash || entry.kind != kind {
        return false
    }
    if entry.environmentKey != environmentKey || entry.customKey != customKey {
        return false
    }
    return compareStrings(entry.name, name) == 0
}

// The slot this key occupies, or -1. Never writes.
function findCacheSlot(cache: borrow ResolutionCache, hash: Int, name: borrow String, kind: Int, environmentKey: Int, customKey: Int) -> Int {
    let start = probeStart(cache, hash, environmentKey, customKey)
    var step = 0
    while step < cacheProbeLimit() {
        let slot = (start + step) & cache.mask
        if entryMatches(cache.entries[slot], hash, name, kind, environmentKey, customKey) {
            return slot
        }
        if !cache.entries[slot].used {
            return 0 - 1
        }
        step = step + 1
    }
    return 0 - 1
}

// The slot a new entry goes in: the first free one within the probe bound, or
// the start of the run, which evicts.
function claimCacheSlot(cache: borrow mut ResolutionCache, hash: Int, environmentKey: Int, customKey: Int) -> Int {
    let start = probeStart(cache, hash, environmentKey, customKey)
    var step = 0
    while step < cacheProbeLimit() {
        let slot = (start + step) & cache.mask
        if !cache.entries[slot].used {
            return slot
        }
        step = step + 1
    }
    cache.evictions = cache.evictions + 1
    return start
}

// Level one: the rendition a name and an environment select.
function cachedResolve(cache: borrow mut ResolutionCache, stack: borrow CatalogStack, name: borrow String, kind: Int, environment: borrow UIEnvironment) -> ResolvedRendition {
    let hash = nameHash(name)
    let fixedKey = environmentKey(environment)
    let customKey = environmentCustomKey(environment)
    let existing = findCacheSlot(cache, hash, name, kind, fixedKey, customKey)
    if existing >= 0 {
        cache.hits = cache.hits + 1
        return cache.entries[existing].resolved
    }
    cache.misses = cache.misses + 1
    let resolved = resolveResource(stack, name, kind, environment)
    let slot = claimCacheSlot(cache, hash, fixedKey, customKey)
    var entry = CacheEntry()
    entry.used = true
    entry.hash = hash
    entry.name = name
    entry.kind = kind
    entry.environmentKey = fixedKey
    entry.customKey = customKey
    entry.resolved = resolved
    cache.entries[slot] = entry
    return resolved
}

// Level two: the decoded colour, kept beside the rendition that produced it.
function cachedColor(cache: borrow mut ResolutionCache, stack: borrow CatalogStack, name: borrow String, environment: borrow UIEnvironment) -> Color {
    let kind = kindColor()
    let hash = nameHash(name)
    let fixedKey = environmentKey(environment)
    let customKey = environmentCustomKey(environment)
    let existing = findCacheSlot(cache, hash, name, kind, fixedKey, customKey)
    if existing >= 0 && cache.entries[existing].colorReady {
        cache.hits = cache.hits + 1
        return cache.entries[existing].color
    }

    let resolution = resolveColorChecked(stack, name, environment)
    if existing >= 0 {
        cache.hits = cache.hits + 1
        cache.entries[existing].color = resolution.color
        cache.entries[existing].colorReady = true
        return resolution.color
    }

    cache.misses = cache.misses + 1
    let slot = claimCacheSlot(cache, hash, fixedKey, customKey)
    var entry = CacheEntry()
    entry.used = true
    entry.hash = hash
    entry.name = name
    entry.kind = kind
    entry.environmentKey = fixedKey
    entry.customKey = customKey
    entry.resolved = resolveResource(stack, name, kind, environment)
    entry.color = resolution.color
    entry.colorReady = true
    cache.entries[slot] = entry
    return resolution.color
}

// What fraction of lookups the cache answered, as a percentage. For a
// diagnostic overlay; a paint pass never asks.
function cacheHitRate(cache: borrow ResolutionCache) -> Int {
    let total = cache.hits + cache.misses
    if total == 0 {
        return 0
    }
    return (cache.hits * 100) / total
}
