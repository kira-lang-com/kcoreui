import Foundation
import KCoreUI

// The wire mappings of the closed vocabularies.
//
// A kind, a trait identifier and a blend mode live on the wire as bare
// integers and in the program as enums. These cases pin the two facts that
// make that safe: every named variant sits on the wire value the format
// assigned it and no other, and the integer-to-enum direction is total, so a
// value this build has no name for survives a round trip unchanged.

// The named resource kinds sit on their assigned wire values.
construct KcuResourceKindWireValuesAreFixed() extends Test {
    test {
        return ResourceKind.Color.value() == 1
            && ResourceKind.Gradient.value() == 2
            && ResourceKind.Material.value() == 3
            && ResourceKind.Effect.value() == 4
            && ResourceKind.Typography.value() == 5
            && (
                ResourceKind.Custom(ResourceKindRange.customBase)
            ).value() == ResourceKindRange.customBase
            && (ResourceKind.Unknown(9)).value() == 9
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Integer to kind and back is the identity for every wire value, named or not,
// and the custom range starts exactly at the base the format reserves.
construct KcuResourceKindMappingIsTotal() extends Test {
    test {
        for value in 0..1100 {
            if (resourceKindFromValue(value)).value() != value { return false }
        }
        return (resourceKindFromValue(3)).equals(.Material)
            && (resourceKindFromValue(ResourceKindRange.customBase)).equals(
                .Custom(ResourceKindRange.customBase)
            )
            && (resourceKindFromValue(ResourceKindRange.customBase - 1)).equals(
                .Unknown(ResourceKindRange.customBase - 1)
            )
            && (resourceKindFromValue(0)).equals(.Unknown(0))
            && !(resourceKindFromValue(0)).isKnown()
            && ResourceKind.Typography.isKnown()
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The named trait identifiers sit on their assigned wire values, ascending in
// priority order, and the custom range starts at the reserved base.
construct KcuTraitIdentifierWireValuesAreFixed() extends Test {
    test {
        return TraitIdentifier.Appearance.value() == 0
            && TraitIdentifier.Contrast.value() == 1
            && TraitIdentifier.Gamut.value() == 2
            && TraitIdentifier.Scale.value() == 3
            && TraitIdentifier.Idiom.value() == 4
            && TraitIdentifier.Platform.value() == 5
            && TraitIdentifier.LayoutDirection.value() == 6
            && TraitIdentifier.HorizontalSizeClass.value() == 7
            && TraitIdentifier.VerticalSizeClass.value() == 8
            && TraitIdentifier.ReduceTransparency.value() == 9
            && TraitIdentifier.ReduceMotion.value() == 10
            && TraitIdentifier.InvertColors.value() == 11
            && TraitIdentifier.DifferentiateWithoutColor.value() == 12
            && TraitIdentifierRange.customBase == 64
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// Integer to trait identifier and back is the identity across the built-in
// range, the reserved gap and the custom range.
construct KcuTraitIdentifierMappingIsTotal() extends Test {
    test {
        for value in 0..200 {
            if (traitIdentifierFromValue(value)).value() != value { return false }
        }
        return (traitIdentifierFromValue(12)).equals(.DifferentiateWithoutColor)
            && (traitIdentifierFromValue(13)).equals(.Unknown(13))
            && (traitIdentifierFromValue(63)).equals(.Unknown(63))
            && (traitIdentifierFromValue(64)).equals(.Custom(64))
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}

// The named blend modes sit on their assigned wire values and every other u8
// value survives the round trip as itself.
construct KcuBlendModeMappingIsTotal() extends Test {
    test {
        for value in 0..256 {
            if (blendModeFromValue(value)).value() != value { return false }
        }
        return BlendMode.Normal.value() == 0
            && BlendMode.LinearDodge.value() == 1
            && BlendMode.ColorDodge.value() == 2
            && BlendMode.HardLight.value() == 3
            && BlendMode.Overlay.value() == 4
            && BlendMode.Lighten.value() == 5
            && BlendMode.Darken.value() == 6
            && BlendMode.Multiply.value() == 7
            && BlendMode.Luminosity.value() == 8
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(true)
        return e
    }
}
