import Foundation
import KCoreUI

// Mirroring the shipped blob into generated source.
//
// The blob is the artifact and the source of truth; this is generated *from*
// it, never the other way round. It exists because a library cannot ship a
// floor as a file path: KCoreUI does not know what directory a program using it
// will be run from, and a resource system whose completeness depends on a
// relative path resolves to the debug colour on someone else's machine.
//
// A test asserts the two agree, so a blob edited in an editor and not
// re-emitted is caught rather than silently ignored.

function emittedPath() -> String {
    return "app/Names/DefaultCatalog.kira"
}

// How many bytes of hex go on one line. Sixty-four bytes is 128 characters,
// which keeps the generated file inside the line length the rest of the
// repository is written to and its length under the file-size ceiling.
function bytesPerLine() -> Int {
    return 64
}

function emitHeader(resourceCount: Int, renditionCount: Int, byteCount: Int) -> String {
    var text = "import Foundation\n\n"
    text = text + "// Generated by tools/bootstrap from Resources/Default.kcui. Do not edit.\n"
    text = text + "//\n"
    text = text + "// The default catalog, mirrored into source so the framework's floor travels\n"
    text = text + "// with the library rather than with a working directory. The blob is the\n"
    text = text + "// artifact; this is generated from it. Edit the catalog in an editor, or edit\n"
    text = text + "// tools/bootstrap, then run `kira run tools/bootstrap` from the repository\n"
    text = text + "// root to rewrite both.\n"
    text = text + "//\n"
    text = text + "// " + String(resourceCount) + " resources, " + String(renditionCount)
    text = text + " renditions, " + String(byteCount) + " bytes.\n\n"
    return text
}

function emitChunks(bytes: borrow [U8]) -> String {
    var text = "function defaultCatalogChunks() -> [String] {\n"
    text = text + "    var chunks: [String] = []\n"
    var offset = 0
    while offset < bytes.count {
        let slice = sliceBytes(bytes, offset, bytesPerLine())
        text = text + "    chunks.append(\"" + bytesToHex(slice) + "\")\n"
        offset = offset + bytesPerLine()
    }
    text = text + "    return chunks\n}\n\n"
    return text
}

function emitAccessors() -> String {
    var text = "// The shipped catalog's bytes.\n"
    text = text + "function defaultCatalogBytes() -> [U8] {\n"
    text = text + "    var bytes: [U8] = []\n"
    text = text + "    for chunk in defaultCatalogChunks() {\n"
    text = text + "        appendHexBytes(bytes, chunk)\n"
    text = text + "    }\n"
    text = text + "    return bytes\n"
    text = text + "}\n\n"
    text = text + "// The catalog every stack is founded on.\n"
    text = text + "//\n"
    text = text + "// Parsed rather than trusted: the embedded bytes go through the same parser a\n"
    text = text + "// blob off disk does, so the floor cannot be the one catalog in the system\n"
    text = text + "// that was never checked. A build whose generated source has been damaged\n"
    text = text + "// answers an empty catalog, and the integrity check fails loudly.\n"
    text = text + "function defaultCatalog() -> Catalog {\n"
    text = text + "    attempt {\n"
    text = text + "        let catalog = try parseCatalog(defaultCatalogBytes())\n"
    text = text + "        return catalog\n"
    text = text + "    } handle {\n"
    text = text + "        NotKira { return Catalog() }\n"
    text = text + "        UnsupportedVersion { return Catalog() }\n"
    text = text + "        TruncatedHeader { return Catalog() }\n"
    text = text + "        TruncatedTable { return Catalog() }\n"
    text = text + "        OffsetOutOfRange { return Catalog() }\n"
    text = text + "        NamesUnsorted { return Catalog() }\n"
    text = text + "        ConstraintsUnsorted { return Catalog() }\n"
    text = text + "        DuplicateRendition { return Catalog() }\n"
    text = text + "        ReservedTraitValue { return Catalog() }\n"
    text = text + "    }\n"
    text = text + "}\n\n"
    text = text + "// Resources founded on the shipped catalog. What a toolkit calls once at\n"
    text = text + "// start-up, before it has any blob of its own to put above it.\n"
    text = text + "function makeDefaultResources(environment: borrow UIEnvironment) -> UIResources {\n"
    text = text + "    return makeResources(defaultCatalog(), environment)\n"
    text = text + "}\n"
    return text
}

function emitDefaultCatalogSource(bytes: borrow [U8], resourceCount: Int, renditionCount: Int) -> String {
    var text = emitHeader(resourceCount, renditionCount, bytes.count)
    text = text + emitChunks(bytes)
    text = text + emitAccessors()
    return text
}
