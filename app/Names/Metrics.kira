import Foundation

// The lengths a window's chrome is laid out with.
//
// Apple exposes none of these as API. They are what AppKit and SwiftUI lay a
// window out with, so a toolkit drawing its own chrome needs the same numbers
// under names it can ask for. Each name is the measurement, not the view it
// was measured on: `toolbarItemSpacing` is the gap between two pieces of glass
// on the bar, whichever items they hold.
//
// Everything on the bar is centered in its height, so no name here carries a
// vertical offset: an item's top is the bar's height less the item's, halved.

// --- The bar ---------------------------------------------------------------

// The unified title and toolbar band. Content runs underneath it; this is the
// top safe-area inset a window's content is laid out against.
public namespace MetricName {
    let toolbarHeight: String = "toolbarHeight"
    let toolbarCompactHeight: String = "toolbarCompactHeight"
    let toolbarCompactBandHeight: String = "toolbarCompactBandHeight"

    // One piece of glass on the bar, and the width of an item holding an icon.
    let toolbarItemHeight: String = "toolbarItemHeight"
    let toolbarItemWidth: String = "toolbarItemWidth"

    // The gap between two items sharing one piece of glass, and how far the glass
    // holds the first and last of them off its ends. An item alone on its glass
    // is the glass.
    let toolbarGroupSpacing: String = "toolbarGroupSpacing"
    let toolbarGroupInset: String = "toolbarGroupInset"

    // The gap between two pieces of glass, and the width a fixed spacer holds open.
    let toolbarItemSpacing: String = "toolbarItemSpacing"
    let toolbarSpacerWidth: String = "toolbarSpacerWidth"

    // How far the outermost glass sits from the edge of its section.
    let toolbarEdgeInset: String = "toolbarEdgeInset"
    let toolbarCompactEdgeInset: String = "toolbarCompactEdgeInset"

    // How far a column's title sits from the column's leading edge, and from a
    // piece of glass before it -- a back button -- when there is one.

    // How a back button leaves once its stack is back where there is nowhere
    // further back: it swells to this scale as it fades, over this many seconds.
    let toolbarBackRemovalScale: String = "toolbarBackRemovalScale"
    let toolbarBackRemovalDuration: String = "toolbarBackRemovalDuration"

    // The search field `.searchable` puts on the bar: how wide its glass is, how
    // far its magnifier and its end sit inside the glass, and the gap between the
    // magnifier and the text.
    let toolbarSearchWidth: String = "toolbarSearchWidth"
    let toolbarSearchLeading: String = "toolbarSearchLeading"
    let toolbarSearchTrailing: String = "toolbarSearchTrailing"
    let toolbarSearchSpacing: String = "toolbarSearchSpacing"

    // What a piece of glass holds an item's label off its ends by, and the point
    // size and weight its symbols are set at.
    let toolbarItemLabelInset: String = "toolbarItemLabelInset"
    let toolbarSymbolSize: String = "toolbarSymbolSize"
    let toolbarSymbolWeight: String = "toolbarSymbolWeight"

    // --- The window ------------------------------------------------------------

    let windowCornerRadius: String = "windowCornerRadius"

    // The close, minimize and zoom buttons: where the first one starts, how large
    // each one is, the gap between them, and the room left after the last before
    // anything else on the bar.
    let windowControlsLeading: String = "windowControlsLeading"
    let windowControlDiameter: String = "windowControlDiameter"
    let windowControlSpacing: String = "windowControlSpacing"
    let windowControlsTrailing: String = "windowControlsTrailing"

    // The line between two columns of a split view.

    // --- The sidebar -----------------------------------------------------------
    //
    // A source list in a split view's sidebar column. It starts under the bar;
    // each section opens with a header row, then rows that touch.

    // How wide the column opens: in a window of regular width, and in an expanded
    // one.
    let sidebarWidth: String = "sidebarWidth"
    let sidebarExpandedWidth: String = "sidebarExpandedWidth"

    // A section's header row, how far its title sits from the column's edge, and
    // how far down the row the title's line starts: a header sits low in its row,
    // close to the rows it heads.
    let sidebarHeaderHeight: String = "sidebarHeaderHeight"
    let sidebarHeaderInset: String = "sidebarHeaderInset"
    let sidebarHeaderTopInset: String = "sidebarHeaderTopInset"

    // One row, and how far its content sits from each edge of the column.
    let sidebarRowHeight: String = "sidebarRowHeight"
    let sidebarRowInset: String = "sidebarRowInset"

    // The band behind the selected row: how far it sits from each edge of the
    // column, and its corner radius. The corner is continuous.
    let sidebarSelectionInset: String = "sidebarSelectionInset"
    let sidebarSelectionRadius: String = "sidebarSelectionRadius"

    // A row's symbol column, the gap after it to the title, and the point size
    // the symbol is set at.
    let sidebarIconColumn: String = "sidebarIconColumn"
    let sidebarTitleSpacing: String = "sidebarTitleSpacing"
    let sidebarSymbolSize: String = "sidebarSymbolSize"
    let sidebarToggleResponse: String = "sidebarToggleResponse"
    let sidebarToggleDamping: String = "sidebarToggleDamping"
    let sidebarGlassBleed: String = "sidebarGlassBleed"
    let sidebarShadowRadius: String = "sidebarShadowRadius"

    // --- The inset grouped list ------------------------------------------------
    //
    // SwiftUI's `Form`, and a `List` in the inset grouped style: sections, each a
    // header over a card of rows over a footer, in one readable column centered in
    // the room it has.

    // The widest the column grows; the gap between two sections' cards, and
    // between two sections when a header or a footer stands between them; and
    // the room above the first section and below the last.
    let listReadableWidth: String = "listReadableWidth"
    let listSectionSpacing: String = "listSectionSpacing"
    let listLabeledSectionSpacing: String = "listLabeledSectionSpacing"
    let listTopInset: String = "listTopInset"

    // The card: its continuous corner, a row's least height, how far a row's
    // content and its separator sit from the card's edges and from the row's
    // top and bottom, the separator's thickness, and the gap between a row's
    // trailing accessories.
    let listCornerRadius: String = "listCornerRadius"
    let listRowHeight: String = "listRowHeight"
    let listRowInset: String = "listRowInset"
    let listRowVerticalInset: String = "listRowVerticalInset"
    let listSeparatorThickness: String = "listSeparatorThickness"
    let listAccessorySpacing: String = "listAccessorySpacing"

    // The share of a labeled row a desktop's grouped form gives the value, the
    // rest going to the label.
    let listValueColumnShare: String = "listValueColumnShare"

    // What a header holds above its title and between its title and the card,
    // and what a footer holds above and below its text. Both start at the row
    // inset.
    let listHeaderTopInset: String = "listHeaderTopInset"
    let listHeaderBottomInset: String = "listHeaderBottomInset"
    let listFooterTopInset: String = "listFooterTopInset"
    let listFooterBottomInset: String = "listFooterBottomInset"

    // How far a row's content steps in for each level of an outline.
    let listIndentation: String = "listIndentation"

    // --- The large title ---------------------------------------------------------
    //
    // A column's title set large under the bar: how far below the bar its line
    // starts, and the room under it before the content.
    let largeTitleTopInset: String = "largeTitleTopInset"
    let largeTitleBottomInset: String = "largeTitleBottomInset"
    let largeTitleFadeDuration: String = "largeTitleFadeDuration"
    let largeTitleInlineTravel: String = "largeTitleInlineTravel"
    let largeTitleInlineBlur: String = "largeTitleInlineBlur"
    let scrollEdgeBlurRadius: String = "scrollEdgeBlurRadius"
    let scrollEdgeBorderWidth: String = "scrollEdgeBorderWidth"

    // --- The navigation transition -----------------------------------------------
    //
    // A pushed view slides in over the one it covers and slides back off it, by a
    // swipe or the back button. While it moves its corners are rounded, and the
    // view under it sits a little smaller and dimmed, coming up to full size and
    // light as it is uncovered. A swipe that lifts past the commit fraction, or
    // throws faster than the commit velocity (points a second), goes back; one
    // that does neither settles where it started. A swipe is only a swipe once it
    // has moved the slop, and moved it more across than down.
    let navigationPageCornerRadius: String = "navigationPageCornerRadius"
    let navigationCoveredDim: String = "navigationCoveredDim"
    let navigationCoveredParallax: String = "navigationCoveredParallax"
    let navigationPushResponse: String = "navigationPushResponse"
    let navigationPushDamping: String = "navigationPushDamping"
    let navigationSwipeCommitFraction: String = "navigationSwipeCommitFraction"
    let navigationSwipeCommitVelocity: String = "navigationSwipeCommitVelocity"
    let navigationSwipeSlop: String = "navigationSwipeSlop"

    // --- The scroll indicator ----------------------------------------------------
    //
    // The bar along a scroll view's trailing edge while it scrolls: its thickness,
    // and its thickness while the pointer holds it to scrub; the shortest it gets
    // over long content, and the shortest it squeezes to pulled past an end; how
    // far beyond it a pointer still takes it, across and along; and how long it
    // stays after scrolling stops, how long it takes to fade, and how long it
    // takes to swell and to thin back.
    let scrollIndicatorThickness: String = "scrollIndicatorThickness"
    let scrollIndicatorExpandedThickness: String = "scrollIndicatorExpandedThickness"
    let scrollIndicatorMinimumLength: String = "scrollIndicatorMinimumLength"
    let scrollIndicatorOverscrolledLength: String = "scrollIndicatorOverscrolledLength"
    let scrollIndicatorHitOutsetAcross: String = "scrollIndicatorHitOutsetAcross"
    let scrollIndicatorHitOutsetAlong: String = "scrollIndicatorHitOutsetAlong"
    let scrollIndicatorHideDelay: String = "scrollIndicatorHideDelay"
    let scrollIndicatorFadeDuration: String = "scrollIndicatorFadeDuration"
    let scrollIndicatorExpandDuration: String = "scrollIndicatorExpandDuration"
    let scrollIndicatorCollapseDuration: String = "scrollIndicatorCollapseDuration"
    let menuMorphGrowthResponse: String = "menuMorphGrowthResponse"
    let menuMorphGrowthDamping: String = "menuMorphGrowthDamping"
    let menuMorphHeightResponse: String = "menuMorphHeightResponse"
    let menuMorphHeightDamping: String = "menuMorphHeightDamping"
    let menuMorphDropResponse: String = "menuMorphDropResponse"
    let menuMorphDropDamping: String = "menuMorphDropDamping"
    let menuMorphDropLaunch: String = "menuMorphDropLaunch"
    let menuMorphCloseResponse: String = "menuMorphCloseResponse"
    let menuMorphCloseDamping: String = "menuMorphCloseDamping"
    let menuMorphFlightResponse: String = "menuMorphFlightResponse"
    let menuMorphFlightDamping: String = "menuMorphFlightDamping"
    let menuMorphCornerResponse: String = "menuMorphCornerResponse"
    let menuMorphCloseCornerResponse: String = "menuMorphCloseCornerResponse"
    let menuMorphCloseDuration: String = "menuMorphCloseDuration"
    let menuMorphRoundness: String = "menuMorphRoundness"
    let menuMorphContentOpen: String = "menuMorphContentOpen"
    let menuMorphContentClose: String = "menuMorphContentClose"
    let menuMorphContentZoom: String = "menuMorphContentZoom"
    let menuMorphContentBlur: String = "menuMorphContentBlur"
    let menuMorphGlyphGone: String = "menuMorphGlyphGone"
    let menuMorphGlyphReturn: String = "menuMorphGlyphReturn"
    let menuMorphGlyphBack: String = "menuMorphGlyphBack"
    let menuMorphGlyphBlur: String = "menuMorphGlyphBlur"
    let menuMorphHomeReach: String = "menuMorphHomeReach"
    let menuMorphHomeDepth: String = "menuMorphHomeDepth"
    let menuMorphHomeSurface: String = "menuMorphHomeSurface"
    let menuMorphHomeLead: String = "menuMorphHomeLead"
    let menuMorphHomeBlend: String = "menuMorphHomeBlend"
    let menuSubmenuOpenResponse: String = "menuSubmenuOpenResponse"
    let menuSubmenuOpenDamping: String = "menuSubmenuOpenDamping"
    let menuSubmenuCloseResponse: String = "menuSubmenuCloseResponse"
    let menuSubmenuCloseDamping: String = "menuSubmenuCloseDamping"
    let menuSubmenuRecededOpacity: String = "menuSubmenuRecededOpacity"
    let menuSubmenuRecedeScale: String = "menuSubmenuRecedeScale"
    let menuSubmenuRecedeHold: String = "menuSubmenuRecedeHold"
    let menuSubmenuDwell: String = "menuSubmenuDwell"
    let menuSubmenuWiden: String = "menuSubmenuWiden"
    let menuSubmenuRecedeInResponse: String = "menuSubmenuRecedeInResponse"
    let menuSubmenuRecedeInDamping: String = "menuSubmenuRecedeInDamping"
    let menuSubmenuRecedeOutResponse: String = "menuSubmenuRecedeOutResponse"
    let menuSubmenuRecedeOutDamping: String = "menuSubmenuRecedeOutDamping"
    let menuSubmenuShrinkResponse: String = "menuSubmenuShrinkResponse"
    let menuSubmenuShrinkDamping: String = "menuSubmenuShrinkDamping"
    let menuSubmenuRise: String = "menuSubmenuRise"
    let menuSubmenuRiseLaunch: String = "menuSubmenuRiseLaunch"
    let menuSubmenuHeaderCenter: String = "menuSubmenuHeaderCenter"
    let menuSubmenuChevronTurn: String = "menuSubmenuChevronTurn"
    let menuSubmenuCardAppear: String = "menuSubmenuCardAppear"
    let menuSubmenuCardAppearSpan: String = "menuSubmenuCardAppearSpan"
    let menuSubmenuCardVanish: String = "menuSubmenuCardVanish"
    let menuSubmenuItemsAppear: String = "menuSubmenuItemsAppear"
    let menuSubmenuItemsAppearSpan: String = "menuSubmenuItemsAppearSpan"
    let menuSubmenuItemsVanish: String = "menuSubmenuItemsVanish"
    let menuSubmenuItemsVanishSpan: String = "menuSubmenuItemsVanishSpan"

    // --- Menus -------------------------------------------------------------------
    //
    // How far under the control that opened it a menu's card hangs.
    let menuAnchorSpacing: String = "menuAnchorSpacing"

    // --- The tab bar -------------------------------------------------------------
    //
    // The bar a `TabView` floats in the toolbar's row: its height and what it
    // holds its tabs off its glass by, then a tab's height and what a tab holds its
    // title, or a symbol tab its symbol, off its own ends.
    let tabBarHeight: String = "tabBarHeight"
    let tabBarInset: String = "tabBarInset"
    let tabHeight: String = "tabHeight"
    let tabLabelInset: String = "tabLabelInset"
    let tabSymbolInset: String = "tabSymbolInset"

    // --- The phone's tab bar -------------------------------------------------------
    //
    // The bar a `TabView` floats at the foot of a phone's screen: how far its
    // tabs keep off the screen's sides at most and off its bottom, and how far
    // its glass reaches past them. Then a tab: its width with the selection
    // capsule that reaches past its ends, its height, and how far each tab
    // overlaps the next; how far its symbol stands off its top and its label off
    // its ends; its symbol's size and line, its title's size and line, and the
    // gap between the two.
    let phoneTabBarEdgeInset: String = "phoneTabBarEdgeInset"
    let phoneTabBarBottomInset: String = "phoneTabBarBottomInset"
    let phoneTabBarGlassOutset: String = "phoneTabBarGlassOutset"
    let phoneTabWidth: String = "phoneTabWidth"
    let phoneTabHeight: String = "phoneTabHeight"
    let phoneTabOverlap: String = "phoneTabOverlap"
    let phoneTabTopInset: String = "phoneTabTopInset"
    let phoneTabSideInset: String = "phoneTabSideInset"
    let phoneTabSymbolSize: String = "phoneTabSymbolSize"
    let phoneTabSymbolLine: String = "phoneTabSymbolLine"
    let phoneTabTitleSize: String = "phoneTabTitleSize"
    let phoneTabTitleLine: String = "phoneTabTitleLine"
    let phoneTabTitleSpacing: String = "phoneTabTitleSpacing"

    // --- Control sizes -------------------------------------------------------------
    //
    // An inline control at each size: how tall it stands, how far its label is
    // held off its ends, the size its label is set at, and how tall a text
    // field of that size stands. A field's text is held off its ends by one
    // inset at every size.
    let controlMiniHeight: String = "controlMiniHeight"
    let controlMiniLabelInset: String = "controlMiniLabelInset"
    let controlMiniFontSize: String = "controlMiniFontSize"
    let controlMiniFieldHeight: String = "controlMiniFieldHeight"
    let controlSmallHeight: String = "controlSmallHeight"
    let controlSmallLabelInset: String = "controlSmallLabelInset"
    let controlSmallFontSize: String = "controlSmallFontSize"
    let controlSmallFieldHeight: String = "controlSmallFieldHeight"
    let controlRegularHeight: String = "controlRegularHeight"
    let controlRegularLabelInset: String = "controlRegularLabelInset"
    let controlRegularFontSize: String = "controlRegularFontSize"
    let controlRegularFieldHeight: String = "controlRegularFieldHeight"
    let controlLargeHeight: String = "controlLargeHeight"
    let controlLargeLabelInset: String = "controlLargeLabelInset"
    let controlLargeFontSize: String = "controlLargeFontSize"
    let controlLargeFieldHeight: String = "controlLargeFieldHeight"
    let fieldLabelInset: String = "fieldLabelInset"


    // How round a control's bezel is at each control size: a button's or a
    // pop-up's, and a text field's.
    let controlMiniCornerRadius: String = "controlMiniCornerRadius"
    let controlSmallCornerRadius: String = "controlSmallCornerRadius"
    let controlRegularCornerRadius: String = "controlRegularCornerRadius"
    let controlLargeCornerRadius: String = "controlLargeCornerRadius"
    let controlMiniFieldCornerRadius: String = "controlMiniFieldCornerRadius"
    let controlSmallFieldCornerRadius: String = "controlSmallFieldCornerRadius"
    let controlRegularFieldCornerRadius: String = "controlRegularFieldCornerRadius"
    let controlLargeFieldCornerRadius: String = "controlLargeFieldCornerRadius"

    // A pop-up button at each control size: how tall it stands, how far its
    // title is held off its leading end, the gap between the title and its
    // chevron, the size the chevron is drawn at, and how far the chevron is
    // held off the trailing end.
    let popUpMiniHeight: String = "popUpMiniHeight"
    let popUpMiniLeadingInset: String = "popUpMiniLeadingInset"
    let popUpMiniChevronSpacing: String = "popUpMiniChevronSpacing"
    let popUpMiniChevronSize: String = "popUpMiniChevronSize"
    let popUpMiniTrailingInset: String = "popUpMiniTrailingInset"
    let popUpSmallHeight: String = "popUpSmallHeight"
    let popUpSmallLeadingInset: String = "popUpSmallLeadingInset"
    let popUpSmallChevronSpacing: String = "popUpSmallChevronSpacing"
    let popUpSmallChevronSize: String = "popUpSmallChevronSize"
    let popUpSmallTrailingInset: String = "popUpSmallTrailingInset"
    let popUpRegularHeight: String = "popUpRegularHeight"
    let popUpRegularLeadingInset: String = "popUpRegularLeadingInset"
    let popUpRegularChevronSpacing: String = "popUpRegularChevronSpacing"
    let popUpRegularChevronSize: String = "popUpRegularChevronSize"
    let popUpRegularTrailingInset: String = "popUpRegularTrailingInset"
    let popUpLargeHeight: String = "popUpLargeHeight"
    let popUpLargeLeadingInset: String = "popUpLargeLeadingInset"
    let popUpLargeChevronSpacing: String = "popUpLargeChevronSpacing"
    let popUpLargeChevronSize: String = "popUpLargeChevronSize"
    let popUpLargeTrailingInset: String = "popUpLargeTrailingInset"

    // A checkbox at each control size: the side of its box, how round the box
    // is, the size its checkmark is drawn at, and the gap before its title.
    let checkboxMiniSize: String = "checkboxMiniSize"
    let checkboxMiniCornerRadius: String = "checkboxMiniCornerRadius"
    let checkboxMiniCheckmarkSize: String = "checkboxMiniCheckmarkSize"
    let checkboxMiniSpacing: String = "checkboxMiniSpacing"
    let checkboxSmallSize: String = "checkboxSmallSize"
    let checkboxSmallCornerRadius: String = "checkboxSmallCornerRadius"
    let checkboxSmallCheckmarkSize: String = "checkboxSmallCheckmarkSize"
    let checkboxSmallSpacing: String = "checkboxSmallSpacing"
    let checkboxRegularSize: String = "checkboxRegularSize"
    let checkboxRegularCornerRadius: String = "checkboxRegularCornerRadius"
    let checkboxRegularCheckmarkSize: String = "checkboxRegularCheckmarkSize"
    let checkboxRegularSpacing: String = "checkboxRegularSpacing"
    let checkboxLargeSize: String = "checkboxLargeSize"
    let checkboxLargeCornerRadius: String = "checkboxLargeCornerRadius"
    let checkboxLargeCheckmarkSize: String = "checkboxLargeCheckmarkSize"
    let checkboxLargeSpacing: String = "checkboxLargeSpacing"

    // --- Switches, sliders and progress bars ---------------------------------------
    //
    // A switch at each control size: its capsule track and the knob held inside
    // it, off its ends. A slider at each control size: its height, the track
    // running through its middle, the knob riding it, and how far in from
    // either end of the track the knob's center stops. A progress bar's track.
    let switchMiniWidth: String = "switchMiniWidth"
    let switchMiniHeight: String = "switchMiniHeight"
    let switchMiniKnobWidth: String = "switchMiniKnobWidth"
    let switchMiniKnobInset: String = "switchMiniKnobInset"
    let switchSmallWidth: String = "switchSmallWidth"
    let switchSmallHeight: String = "switchSmallHeight"
    let switchSmallKnobWidth: String = "switchSmallKnobWidth"
    let switchSmallKnobInset: String = "switchSmallKnobInset"
    let switchRegularWidth: String = "switchRegularWidth"
    let switchRegularHeight: String = "switchRegularHeight"
    let switchRegularKnobWidth: String = "switchRegularKnobWidth"
    let switchRegularKnobInset: String = "switchRegularKnobInset"
    let switchLargeWidth: String = "switchLargeWidth"
    let switchLargeHeight: String = "switchLargeHeight"
    let switchLargeKnobWidth: String = "switchLargeKnobWidth"
    let switchLargeKnobInset: String = "switchLargeKnobInset"
    let sliderMiniHeight: String = "sliderMiniHeight"
    let sliderMiniTrackHeight: String = "sliderMiniTrackHeight"
    let sliderMiniKnobWidth: String = "sliderMiniKnobWidth"
    let sliderMiniKnobHeight: String = "sliderMiniKnobHeight"
    let sliderMiniKnobInset: String = "sliderMiniKnobInset"
    let sliderSmallHeight: String = "sliderSmallHeight"
    let sliderSmallTrackHeight: String = "sliderSmallTrackHeight"
    let sliderSmallKnobWidth: String = "sliderSmallKnobWidth"
    let sliderSmallKnobHeight: String = "sliderSmallKnobHeight"
    let sliderSmallKnobInset: String = "sliderSmallKnobInset"
    let sliderRegularHeight: String = "sliderRegularHeight"
    let sliderRegularTrackHeight: String = "sliderRegularTrackHeight"
    let sliderRegularKnobWidth: String = "sliderRegularKnobWidth"
    let sliderRegularKnobHeight: String = "sliderRegularKnobHeight"
    let sliderRegularKnobInset: String = "sliderRegularKnobInset"
    let sliderLargeHeight: String = "sliderLargeHeight"
    let sliderLargeTrackHeight: String = "sliderLargeTrackHeight"
    let sliderLargeKnobWidth: String = "sliderLargeKnobWidth"
    let sliderLargeKnobHeight: String = "sliderLargeKnobHeight"
    let sliderLargeKnobInset: String = "sliderLargeKnobInset"
    let sliderHeldKnobWidth: String = "sliderHeldKnobWidth"
    let sliderHeldKnobHeight: String = "sliderHeldKnobHeight"
    let progressTrackHeight: String = "progressTrackHeight"
    // The height a progress bar stands, its track centered in it, and the
    // width of the edge drawn around that track.
    let progressHeight: String = "progressHeight"
    let progressTrackBorderWidth: String = "progressTrackBorderWidth"
    // The two shadows under a slider's knob: a soft one that falls away from it,
    // and a tight one where it meets the track.
    // The insertion point in a focused field.
    let caretWidth: String = "caretWidth"
    let caretHeight: String = "caretHeight"
    // How opaque a switch or slider stands while it is disabled.
    let disabledControlOpacity: String = "disabledControlOpacity"
    let knobShadowRadius: String = "knobShadowRadius"
    let knobShadowOffset: String = "knobShadowOffset"
    let knobContactShadowRadius: String = "knobContactShadowRadius"
    let knobContactShadowOffset: String = "knobContactShadowOffset"
    // --- Menu geometry ------------------------------------------------------------
    //
    // A menu's card and what is in it, at the regular control size: its rows and
    // the type in them, the card's width, air and corner, the rule between two
    // groups, the glyph column and the chevron, and the actions across its top. A
    // computer's menu is the platform's dense one; a touch screen's has rows a
    // finger can land on.
    let menuRowHeight: String = "menuRowHeight"
    let menuLeadingInset: String = "menuLeadingInset"
    let menuTrailingInset: String = "menuTrailingInset"
    let menuLabelSize: String = "menuLabelSize"
    let menuCardWidth: String = "menuCardWidth"
    let menuCardPadding: String = "menuCardPadding"
    let menuCardRadius: String = "menuCardRadius"
    let menuDividerInset: String = "menuDividerInset"
    let menuDividerVerticalInset: String = "menuDividerVerticalInset"
    let menuActionPadding: String = "menuActionPadding"
    let menuPillInset: String = "menuPillInset"
    let menuChevronBox: String = "menuChevronBox"
    let menuChevronSize: String = "menuChevronSize"
    let menuIconColumn: String = "menuIconColumn"
    let menuIconGap: String = "menuIconGap"
    let menuActionIconSize: String = "menuActionIconSize"
    let menuActionLabelSize: String = "menuActionLabelSize"
    let menuActionSpacing: String = "menuActionSpacing"
    let menuActionsTopInset: String = "menuActionsTopInset"
    let menuActionsBottomInset: String = "menuActionsBottomInset"
    let menuActionsInset: String = "menuActionsInset"
    let menuActionsGap: String = "menuActionsGap"

    // The shadow a menu's card casts: how far it blurs, and how far below the card it falls.
    let menuShadowRadius: String = "menuShadowRadius"
    let menuShadowOffset: String = "menuShadowOffset"

    // --- Menu bar -----------------------------------------------------------------
    //
    // The row of menus across the top of a window: its height, the pill a title
    // lights in when its menu is out and the room the title holds in it, the gap
    // between two titles, and how far under its title a menu's card hangs.
    let menuBarHeight: String = "menuBarHeight"
    let menuBarTitleHeight: String = "menuBarTitleHeight"
    let menuBarTitlePadding: String = "menuBarTitlePadding"
    let menuBarTitleSpacing: String = "menuBarTitleSpacing"
    let menuBarCardGap: String = "menuBarCardGap"

    // --- Workspaces ---------------------------------------------------------------
    //
    // A workspace's panels: the gap between them; the room a tab holds its cross
    // in by; how far a panel holds its strip off its edges; the band a divider is
    // grabbed by; how wide each edge opens and how small it may be dragged before
    // it folds away.
    let workspaceGap: String = "workspaceGap"
    let workspaceTabSpacing: String = "workspaceTabSpacing"
    let workspaceStripInset: String = "workspaceStripInset"
    let workspaceDividerThickness: String = "workspaceDividerThickness"
    let workspaceLeadingWidth: String = "workspaceLeadingWidth"
    let workspaceTrailingWidth: String = "workspaceTrailingWidth"
    let workspaceBottomHeight: String = "workspaceBottomHeight"
