import Foundation
import KCoreUI

// The default catalog's colors.
//
// Values are Apple's, read off the variables of the iOS and iPadOS 27 design
// kit: every name below is one of the kit's color variables, quoted in its
// light and dark modes. The kit dropped its increased-contrast mode, so these
// resources carry an appearance pair and nothing else. What Apple has no word
// for sits at the end of the file, under the toolkit's own names.
//
// A name that means the same thing as another is written as a reference, not as
// a second copy of the numbers. `foreground` is `label`, and stays `label` in
// dark appearance, in high contrast, and in whatever a future override says,
// because the reference is resolved against the same environment the material
// or the caller resolved against.

// A color quoted in sRGB, stored as the Display P3 the catalog holds.
//
// Every number below came from a design tool or from KiraUI's own tokens, and
// both quote sRGB. The catalog is Display P3, so the conversion happens here,
// once, at authoring — not at resolve, where it would be a guess about what the
// stored numbers had meant.
//
// The two spaces share a transfer curve and a white point, so this is a matrix
// in linear light and nothing is lost: every sRGB color is inside P3.
function rgba(r: Float, g: Float, b: Float, a: Float) -> Color {
    return srgbToP3(Color(r: r, g: g, b: b, a: a))
}

// The same, with the channels in the 0–255 the kit quotes them in, so each
// number below reads exactly as it does in the design file.
function rgba255(r: Float, g: Float, b: Float, a: Float) -> Color {
    return rgba(r / 255.0, g / 255.0, b / 255.0, a)
}

// A color with a light and a dark rendition, which is the shape almost every
// resource in the catalog has.
function adaptiveColor(name: borrow String, light: borrow Color, dark: borrow Color) -> ResourceRecord {
    var resource = ResourceRecord()
    resource.name = name
    resource.kind = .Color

    var lightRendition = RenditionRecord()
    lightRendition.constraints.append(whenAppearance(.Light))
    lightRendition.payload = encodeColor(light)
    resource.renditions.append(lightRendition)

    var darkRendition = RenditionRecord()
    darkRendition.constraints.append(whenAppearance(.Dark))
    darkRendition.payload = encodeColor(dark)
    resource.renditions.append(darkRendition)
    return resource
}

// One name meaning another. No constraints, because an alias holds under every
// environment: what varies is what it points at.
function aliasColor(name: borrow String, target: borrow String) -> ResourceRecord {
    var resource = ResourceRecord()
    resource.name = name
    resource.kind = .Color
    var rendition = RenditionRecord()
    rendition.payload = encodeColorAlias(target)
    resource.renditions.append(rendition)
    return resource
}

// --- The system palette ----------------------------------------------------
//
// The kit's `Accents` and `Grays` collections.

function paletteResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(adaptiveColor(colorSystemRed(), rgba255(255.0, 56.0, 60.0, 1.0), rgba255(255.0, 66.0, 69.0, 1.0)))
    records.append(adaptiveColor(colorSystemOrange(), rgba255(255.0, 141.0, 40.0, 1.0), rgba255(255.0, 146.0, 48.0, 1.0)))
    records.append(adaptiveColor(colorSystemYellow(), rgba255(255.0, 204.0, 0.0, 1.0), rgba255(255.0, 214.0, 0.0, 1.0)))
    records.append(adaptiveColor(colorSystemGreen(), rgba255(52.0, 199.0, 89.0, 1.0), rgba255(48.0, 209.0, 88.0, 1.0)))
    records.append(adaptiveColor(colorSystemMint(), rgba255(0.0, 200.0, 179.0, 1.0), rgba255(0.0, 218.0, 195.0, 1.0)))
    records.append(adaptiveColor(colorSystemTeal(), rgba255(0.0, 195.0, 208.0, 1.0), rgba255(0.0, 210.0, 224.0, 1.0)))
    records.append(adaptiveColor(colorSystemCyan(), rgba255(0.0, 192.0, 232.0, 1.0), rgba255(60.0, 211.0, 254.0, 1.0)))
    records.append(adaptiveColor(colorSystemBlue(), rgba255(0.0, 136.0, 255.0, 1.0), rgba255(0.0, 145.0, 255.0, 1.0)))
    records.append(adaptiveColor(colorSystemIndigo(), rgba255(97.0, 85.0, 245.0, 1.0), rgba255(109.0, 124.0, 255.0, 1.0)))
    records.append(adaptiveColor(colorSystemPurple(), rgba255(203.0, 48.0, 224.0, 1.0), rgba255(219.0, 52.0, 242.0, 1.0)))
    records.append(adaptiveColor(colorSystemPink(), rgba255(255.0, 45.0, 85.0, 1.0), rgba255(255.0, 55.0, 95.0, 1.0)))
    records.append(adaptiveColor(colorSystemBrown(), rgba255(172.0, 127.0, 94.0, 1.0), rgba255(183.0, 138.0, 102.0, 1.0)))

    records.append(adaptiveColor(colorSystemGray(), rgba255(142.0, 142.0, 147.0, 1.0), rgba255(142.0, 142.0, 147.0, 1.0)))
    records.append(adaptiveColor(colorSystemGray2(), rgba255(174.0, 174.0, 178.0, 1.0), rgba255(99.0, 99.0, 102.0, 1.0)))
    records.append(adaptiveColor(colorSystemGray3(), rgba255(199.0, 199.0, 204.0, 1.0), rgba255(72.0, 72.0, 74.0, 1.0)))
    records.append(adaptiveColor(colorSystemGray4(), rgba255(209.0, 209.0, 214.0, 1.0), rgba255(58.0, 58.0, 60.0, 1.0)))
    records.append(adaptiveColor(colorSystemGray5(), rgba255(229.0, 229.0, 234.0, 1.0), rgba255(44.0, 44.0, 46.0, 1.0)))
    records.append(adaptiveColor(colorSystemGray6(), rgba255(242.0, 242.0, 247.0, 1.0), rgba255(28.0, 28.0, 30.0, 1.0)))
    return records
}

// --- The content hierarchy -------------------------------------------------
//
// The kit's `Labels` collection.

function labelResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(adaptiveColor(colorLabel(), rgba255(0.0, 0.0, 0.0, 1.0), rgba255(255.0, 255.0, 255.0, 1.0)))
    records.append(adaptiveColor(colorSecondaryLabel(), rgba255(60.0, 60.0, 67.0, 0.6), rgba255(235.0, 235.0, 245.0, 0.7)))
    records.append(adaptiveColor(colorTertiaryLabel(), rgba255(60.0, 60.0, 67.0, 0.3), rgba255(235.0, 235.0, 245.0, 0.3)))
    records.append(adaptiveColor(colorQuaternaryLabel(), rgba255(60.0, 60.0, 67.0, 0.18), rgba255(235.0, 235.0, 245.0, 0.16)))
    records.append(aliasColor(colorPlaceholderText(), colorTertiaryLabel()))

    // Apple's hierarchical shape styles are the same ladder under shorter
    // names, so they are references rather than a second set of numbers.
    records.append(aliasColor(colorPrimary(), colorLabel()))
    records.append(aliasColor(colorSecondary(), colorSecondaryLabel()))
    records.append(aliasColor(colorTertiary(), colorTertiaryLabel()))
    records.append(aliasColor(colorQuaternary(), colorQuaternaryLabel()))
    records.append(adaptiveColor(colorQuinary(), rgba255(60.0, 60.0, 67.0, 0.1), rgba255(235.0, 235.0, 245.0, 0.1)))
    records.append(aliasColor(colorForeground(), colorLabel()))
    records.append(aliasColor(colorPlaceholder(), colorPlaceholderText()))
    return records
}

// --- Backgrounds, fills, separators ----------------------------------------
//
// The kit's `Backgrounds`, `Backgrounds (Grouped)`, `Fills` and `Separators`
// collections. The grouped ladder is not the plain one: its canvas is the gray
// a grouped table sits on, and its second rung is the white of the table's
// rows.

function surfaceResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(adaptiveColor(colorSystemBackground(), rgba255(255.0, 255.0, 255.0, 1.0), rgba255(0.0, 0.0, 0.0, 1.0)))
    records.append(adaptiveColor(colorSecondarySystemBackground(), rgba255(242.0, 242.0, 247.0, 1.0), rgba255(28.0, 28.0, 30.0, 1.0)))
    records.append(adaptiveColor(colorTertiarySystemBackground(), rgba255(255.0, 255.0, 255.0, 1.0), rgba255(44.0, 44.0, 46.0, 1.0)))
    records.append(adaptiveColor(colorWindowBackground(), rgba255(255.0, 255.0, 255.0, 1.0), rgba255(30.0, 30.0, 30.0, 1.0)))
    records.append(aliasColor(colorBackground(), colorSystemBackground()))

    records.append(adaptiveColor(colorSystemGroupedBackground(), rgba255(242.0, 242.0, 247.0, 1.0), rgba255(0.0, 0.0, 0.0, 1.0)))
    records.append(adaptiveColor(colorSecondarySystemGroupedBackground(), rgba255(255.0, 255.0, 255.0, 1.0), rgba255(28.0, 28.0, 30.0, 1.0)))
    records.append(adaptiveColor(colorTertiarySystemGroupedBackground(), rgba255(242.0, 242.0, 247.0, 1.0), rgba255(44.0, 44.0, 46.0, 1.0)))

    records.append(adaptiveColor(colorSystemFill(), rgba255(120.0, 120.0, 120.0, 0.2), rgba255(120.0, 120.0, 128.0, 0.36)))
    records.append(adaptiveColor(colorSecondarySystemFill(), rgba255(120.0, 120.0, 128.0, 0.16), rgba255(120.0, 120.0, 128.0, 0.32)))
    records.append(adaptiveColor(colorTertiarySystemFill(), rgba255(118.0, 118.0, 128.0, 0.12), rgba255(118.0, 118.0, 128.0, 0.24)))
    records.append(adaptiveColor(colorQuaternarySystemFill(), rgba255(116.0, 116.0, 128.0, 0.08), rgba255(118.0, 118.0, 128.0, 0.18)))
    records.append(aliasColor(colorFill(), colorSystemFill()))

    records.append(adaptiveColor(colorSeparator(), rgba255(0.0, 0.0, 0.0, 0.12), rgba255(255.0, 255.0, 255.0, 0.17)))
    records.append(adaptiveColor(colorOpaqueSeparator(), rgba255(198.0, 198.0, 200.0, 1.0), rgba255(56.0, 56.0, 58.0, 1.0)))
    return records
}

// --- Accents ---------------------------------------------------------------
//
// The kit tints with its blue. Its text selection is one wash in both
// appearances, drawn with a screen blend the catalog does not carry.

function accentResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(aliasColor(colorTint(), colorSystemBlue()))
    records.append(adaptiveColor(colorSelection(), rgba255(80.0, 156.0, 254.0, 0.2), rgba255(80.0, 156.0, 254.0, 0.2)))
    records.append(aliasColor(colorAccentColor(), colorTint()))
    records.append(aliasColor(colorLink(), colorSystemBlue()))
    return records
}

// --- What Apple has no word for --------------------------------------------
//
// These are in the catalog and not in `app/Names`, which is the arrangement the
// design intends. The declared surface is Apple's vocabulary and nothing else;
// a catalog may carry more, and a consumer that needs a concept Apple never
// named writes the name into a blob rather than asking permission from a file
// of constants.
//
// A toolkit needs all four of these and Apple spells none of them: ink that
// stays readable on a filled control, the three semantic intents a button asks
// for by meaning rather than by hue, and the rungs of a border ladder above the
// hairline `separator` already covers.

function toolkitResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    records.append(adaptiveColor("inverseLabel",
        rgba(0.98, 0.98, 1.0, 1.0), rgba(0.06, 0.07, 0.1, 1.0)))

    records.append(adaptiveColor("success",
        rgba(0.12, 0.58, 0.3, 1.0), rgba(0.34, 0.85, 0.52, 1.0)))
    records.append(adaptiveColor("warning",
        rgba(0.78, 0.48, 0.06, 1.0), rgba(0.98, 0.75, 0.25, 1.0)))
    // A destructive action is set in the system red, as Apple's kit sets a
    // destructive menu row: its title and its symbol both.
    records.append(adaptiveColor("danger",
        rgba255(255.0, 56.0, 60.0, 1.0), rgba255(255.0, 66.0, 69.0, 1.0)))

    records.append(adaptiveColor("standardBorder",
        rgba(0.08, 0.1, 0.16, 0.18), rgba(1.0, 1.0, 1.0, 0.18)))
    records.append(adaptiveColor("strongBorder",
        rgba(0.08, 0.1, 0.16, 0.32), rgba(1.0, 1.0, 1.0, 0.32)))
    records.append(adaptiveColor("focusRing",
        rgba(0.2, 0.45, 0.96, 0.86), rgba(0.43, 0.67, 1.0, 0.9)))

    // The selected row of a sidebar. The kit adds its tertiary vibrant fill to
    // the column (237 in light, 18 in dark, linear dodge): in light that
    // saturates every channel to white, and in dark it lifts the column by
    // 18/255, which is white at 7% over near-black.
    records.append(adaptiveColor("sidebarSelection",
        rgba255(255.0, 255.0, 255.0, 1.0), rgba255(255.0, 255.0, 255.0, 0.07)))

    // The kit's iPad tab bar: an unselected tab's title, and the capsule
    // behind the selected one.
    records.append(adaptiveColor("tabLabel",
        rgba255(26.0, 26.0, 26.0, 1.0), rgba255(138.0, 138.0, 138.0, 1.0)))
    records.append(adaptiveColor("tabSelection",
        rgba255(237.0, 237.0, 237.0, 1.0), rgba255(18.0, 18.0, 18.0, 1.0)))

    // The kit's switch: green when on, a gray wash when off, and a white knob
    // either way. The track under a slider's knob and under a progress bar's
    // fill are one lighter wash.
    records.append(adaptiveColor("switchOn",
        rgba255(52.0, 199.0, 89.0, 1.0), rgba255(52.0, 199.0, 89.0, 1.0)))
    records.append(adaptiveColor("switchOff",
        rgba255(60.0, 60.0, 67.0, 0.3), rgba255(120.0, 120.0, 128.0, 0.32)))
    records.append(adaptiveColor("controlKnob",
        rgba255(255.0, 255.0, 255.0, 1.0), rgba255(255.0, 255.0, 255.0, 1.0)))
    records.append(adaptiveColor("knobShadow",
        rgba255(0.0, 0.0, 0.0, 0.12), rgba255(0.0, 0.0, 0.0, 0.12)))
    records.append(adaptiveColor("sliderTrack",
        rgba255(120.0, 120.0, 120.0, 0.2), rgba255(120.0, 120.0, 120.0, 0.2)))
    // A held slider knob is clear glass washed with a little white.
    records.append(adaptiveColor("sliderKnobGlass",
        rgba255(255.0, 255.0, 255.0, 0.09), rgba255(255.0, 255.0, 255.0, 0.09)))
    records.append(adaptiveColor("progressTrack",
        rgba255(120.0, 120.0, 120.0, 0.2), rgba255(120.0, 120.0, 120.0, 0.2)))
    // The kit's menu shadow: black at a quarter in light, nearly half in dark,
    // where it has less to darken.
    records.append(adaptiveColor("menuShadow",
        rgba255(0.0, 0.0, 0.0, 0.25), rgba255(0.0, 0.0, 0.0, 0.45)))
    return records
}

// Every color the default catalog defines.
function defaultColorResources() -> [ResourceRecord] {
    var records: [ResourceRecord] = []
    for record in paletteResources() { records.append(record) }
    for record in labelResources() { records.append(record) }
    for record in surfaceResources() { records.append(record) }
    for record in accentResources() { records.append(record) }
    for record in toolkitResources() { records.append(record) }
    return records
}
