import Foundation
import KCoreUI

// What a producer is stopped from writing.
//
// The parser refuses a malformed container; the validator refuses a malformed
// catalog. Both matter, and they catch different things: a cycle is perfectly
// well-formed bytes describing a graph no resolver can finish walking.

function issueCount(record: borrow CatalogRecord, kind: borrow ValidationKind) -> Number {
    var count = 0
    for entry in record.validate() {
        if entry.kind == kind {
            count++
        }
    }
    return count
}

construct KcuACleanRecordHasNoIssues() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(
            adaptive("label", color(0.0, 0.0, 0.0, 1.0), color(1.0, 1.0, 1.0, 1.0))
        )
        record.resources.append(alias("foreground", "label"))
        return record.validate().count
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(0)
        return e
    }
}

construct KcuADanglingReferenceIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("foreground", "nothingDefinesThis"))
        return issueCount(record, ValidationKind.MissingReference)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

// The check that keeps a cycle out of a shipped blob rather than relying on the
// runtime depth limit to survive one.
construct KcuATwoStepCycleIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("a", "b"))
        record.resources.append(alias("b", "a"))
        return issueCount(record, ValidationKind.ReferenceCycle)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(2)
        return e
    }
}

construct KcuASelfReferenceIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("a", "a"))
        return issueCount(record, ValidationKind.ReferenceCycle)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

construct KcuALongerCycleIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(alias("a", "b"))
        record.resources.append(alias("b", "c"))
        record.resources.append(alias("c", "a"))
        return issueCount(record, ValidationKind.ReferenceCycle)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(3)
        return e
    }
}

// A chain that never closes is not a cycle, however deep it goes.
construct KcuADeepChainIsNotACycle() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(flat("root", color(0.0, 0.0, 0.0, 1.0)))
        record.resources.append(alias("a", "root"))
        record.resources.append(alias("b", "a"))
        record.resources.append(alias("c", "b"))
        record.resources.append(alias("d", "c"))
        return record.validate().count
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(0)
        return e
    }
}

// A material's tint reference participates in the graph exactly as a color
// alias does, so a cycle through a recipe is caught too.
construct KcuACycleThroughAMaterialIsReported() extends Test {
    test {
        var recipe = MaterialValue()
        recipe.layers.append(tintLayer(referenceColor("wash"), 0.5, .Normal))
        var material = ResourceRecord()
        material.name = "wash"
        material.kind = .Color
        var rendition = RenditionRecord()
        rendition.payload = encodeColorAlias("wash")
        material.renditions.append(rendition)

        var record = CatalogRecord()
        record.resources.append(material)
        return issueCount(record, ValidationKind.ReferenceCycle)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

construct KcuADuplicateNameOfTheSameKindIsReported() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(flat("label", color(0.0, 0.0, 0.0, 1.0)))
        record.resources.append(flat("label", color(1.0, 1.0, 1.0, 1.0)))
        return issueCount(record, ValidationKind.DuplicateName)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

// The same name under two kinds is two resources, not a duplicate.
construct KcuTheSameNameUnderTwoKindsIsNotADuplicate() extends Test {
    test {
        var material = ResourceRecord()
        material.name = "regular"
        material.kind = .Material
        var recipe = MaterialValue()
        recipe.layers.append(backdropBlurLayer(28.0))
        var rendition = RenditionRecord()
        rendition.payload = recipe.encoded()
        material.renditions.append(rendition)

        var record = CatalogRecord()
        record.resources.append(flat("regular", color(0.5, 0.5, 0.5, 1.0)))
        record.resources.append(material)
        return record.validate().count
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(0)
        return e
    }
}

construct KcuAResourceWithNoRenditionsIsReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var record = CatalogRecord()
        record.resources.append(resource)
        return issueCount(record, ValidationKind.NoRenditions)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

construct KcuAReservedTraitValueIsReportedBeforeWriting() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var rendition = RenditionRecord()
        rendition.constraints.append(TraitIdentifier.Contrast.constrain(0))
        rendition.payload = authored(color(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(rendition)
        var record = CatalogRecord()
        record.resources.append(resource)
        return issueCount(record, ValidationKind.ReservedTraitValue)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

construct KcuTwoRenditionsPinningTheSameTraitsAreReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var first = RenditionRecord()
        first.constraints.append(Appearance.Dark.constraint())
        first.payload = authored(color(0.0, 0.0, 0.0, 1.0))
        resource.renditions.append(first)
        var second = RenditionRecord()
        second.constraints.append(Appearance.Dark.constraint())
        second.payload = authored(color(1.0, 1.0, 1.0, 1.0))
        resource.renditions.append(second)
        var record = CatalogRecord()
        record.resources.append(resource)
        return issueCount(record, ValidationKind.DuplicateRendition)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

// A payload that does not decode for the kind it is filed under is caught at
// authoring time rather than becoming a debug color on screen.
construct KcuAPayloadThatDoesNotMatchItsKindIsReported() extends Test {
    test {
        var resource = ResourceRecord()
        resource.name = "label"
        resource.kind = .Color
        var rendition = RenditionRecord()
        var payload: [U8] = []
        appendU8(payload, 99)
        appendU8(payload, 1)
        rendition.payload = payload
        resource.renditions.append(rendition)
        var record = CatalogRecord()
        record.resources.append(resource)
        return issueCount(record, ValidationKind.UndecodablePayload)
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(1)
        return e
    }
}

// A kind this build has no decoder for is not an error. The container is
// agnostic about payload, and the validator has to agree with it.
construct KcuAnUndecodableKindIsNotAValidationFailure() extends Test {
    test {
        var record = CatalogRecord()
        record.resources.append(opaqueResource("somethingElse"))
        return record.validate().count
    }
    expect {
        let e: Result<Any, TestFailure> = .Ok(0)
        return e
    }
}
